<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <Platforms>x86;x64</Platforms>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <UseWPF>true</UseWPF>
    <DefineConstants>$(DefineConstants);CEFFLASHBROWSER_TESTS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.6.3" />
    <PackageReference Include="Mzying2001.SimpleMvvm" Version="1.1.5" />
    <PackageReference Include="MSTest.TestFramework" Version="3.6.3" />
    <PackageReference Include="Mzying2001.MonkeySharp.Core" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CefFlashBrowser.Log\CefFlashBrowser.Log.csproj" />
    <ProjectReference Include="..\CefFlashBrowser.Database\CefFlashBrowser.Database.csproj" />
    <ProjectReference Include="..\CefFlashBrowser.Sol\CefFlashBrowser.Sol.vcxproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\CefFlashBrowser\ViewModels\UserScriptItemViewModel.cs" Link="LinkedSources\UserScripts\UserScriptItemViewModel.cs" />
    <Compile Include="..\CefFlashBrowser\ViewModels\UserScriptManagerViewModel.cs" Link="LinkedSources\UserScripts\UserScriptManagerViewModel.cs" />
    <Compile Include="..\CefFlashBrowser\ViewModels\UserScriptBatchUpdateViewModel.cs" Link="LinkedSources\UserScripts\UserScriptBatchUpdateViewModel.cs" />
    <Compile Include="..\CefFlashBrowser\Infrastructure\Collections\ListReorderRequest.cs" Link="LinkedSources\ListReorderRequest.cs" />
    <Compile Include="..\CefFlashBrowser\Services\UserScripts\*.cs" Link="LinkedSources\UserScripts\%(Filename)%(Extension)" />
    <Compile Include="..\CefFlashBrowser\Services\UserScripts\Persistence\*.cs" Link="LinkedSources\UserScripts\%(Filename)%(Extension)" />
    <Compile Include="..\CefFlashBrowser\Models\UserScripts\*.cs" Link="LinkedSources\UserScripts\%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Link source files from the main app -->
  <ItemGroup>
    <Compile Include="..\CefFlashBrowser\Models\Downloads\*.cs" Link="LinkedSources\Downloads\%(Filename)%(Extension)" />
    <Compile Include="..\CefFlashBrowser\Services\Downloads\IDownloadTransfer.cs" Link="LinkedSources\Downloads\IDownloadTransfer.cs" />
    <Compile Include="..\CefFlashBrowser\Services\Downloads\HttpDownloadTransfer.cs" Link="LinkedSources\Downloads\HttpDownloadTransfer.cs" />
    <Compile Include="..\CefFlashBrowser\Services\Downloads\DownloadFiles.cs" Link="LinkedSources\Downloads\DownloadFiles.cs" />
    <Compile Include="..\CefFlashBrowser\Utils\PasswordProtector.cs" Link="LinkedSources\PasswordProtector.cs" />
    <Compile Include="..\CefFlashBrowser\Services\DatabaseService.cs" Link="LinkedSources\DatabaseService.cs" />
    <Compile Include="..\CefFlashBrowser\Services\DatabaseService.Downloads.cs" Link="LinkedSources\DatabaseService.Downloads.cs" />
    <Compile Include="..\CefFlashBrowser\Services\DatabaseService.UserScripts.cs" Link="LinkedSources\DatabaseService.UserScripts.cs" />
    <Compile Include="..\CefFlashBrowser\Services\DatabaseService.WebsiteIcons.cs" Link="LinkedSources\DatabaseService.WebsiteIcons.cs" />
    <Compile Include="..\CefFlashBrowser\Models\WebsiteIconRecord.cs" Link="LinkedSources\WebsiteIconRecord.cs" />
    <Compile Include="..\CefFlashBrowser\Services\FaviconService.cs" Link="LinkedSources\FaviconService.cs" />
    <Compile Include="..\CefFlashBrowser\Utils\ImageDataUrl.cs" Link="LinkedSources\ImageDataUrl.cs" />
    <Compile Include="..\CefFlashBrowser\Views\Converters\WebsiteIconUrlConverter.cs" Link="LinkedSources\WebsiteIconUrlConverter.cs" />
    <Compile Include="..\CefFlashBrowser\Utils\UserScriptDownloadPaths.cs" Link="LinkedSources\UserScriptDownloadPaths.cs" />
    <Compile Include="..\CefFlashBrowser\Utils\Win32.cs" Link="LinkedSources\Win32.cs" />
    <Compile Include="..\CefFlashBrowser\Utils\UrlHelper.cs" Link="LinkedSources\UrlHelper.cs" />
    <Compile Include="..\CefFlashBrowser\Utils\DirectoryHelper.cs" Link="LinkedSources\DirectoryHelper.cs" />
    <Compile Include="..\CefFlashBrowser\Views\Converters\ValueConverterBase.cs" Link="LinkedSources\ValueConverterBase.cs" />
    <Compile Include="..\CefFlashBrowser\Views\Converters\BinaryToSizeStringConverter.cs" Link="LinkedSources\BinaryToSizeStringConverter.cs" />
    <Compile Include="..\CefFlashBrowser\Views\Converters\ZoomLevelToScaleConverter.cs" Link="LinkedSources\ZoomLevelToScaleConverter.cs" />
    <Compile Include="..\CefFlashBrowser\Views\Converters\MultiplyConverter.cs" Link="LinkedSources\MultiplyConverter.cs" />
    <Compile Include="..\CefFlashBrowser\Models\Settings.cs" Link="LinkedSources\Settings.cs" />
    <Compile Include="..\CefFlashBrowser\Data\SettingsJson.cs" Link="LinkedSources\SettingsJson.cs" />
    <Compile Include="..\CefFlashBrowser\Models\SettingModels.cs" Link="LinkedSources\SettingModels.cs" />
    <Compile Include="..\CefFlashBrowser\Models\WindowSizeInfo.cs" Link="LinkedSources\WindowSizeInfo.cs" />
    <Compile Include="..\CefFlashBrowser\Utils\SolHelper.cs" Link="LinkedSources\SolHelper.cs" />
    <Compile Include="..\CefFlashBrowser\Models\Sol\SolObject.cs" Link="LinkedSources\SolObject.cs" />
    <Compile Include="..\CefFlashBrowser\Models\Sol\SolArray.cs" Link="LinkedSources\SolArray.cs" />
    <Compile Include="..\CefFlashBrowser\Models\Sol\SolTypeDesc.cs" Link="LinkedSources\SolTypeDesc.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Security" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <!-- Compiled at runtime by the standalone regression runners. -->
  <ItemGroup>
    <Compile Remove="BrowserRegression\**\*.cs;CommandProxyRegression\**\*.cs" />
    <None Include="BrowserRegression\**\*.cs;CommandProxyRegression\**\*.cs" />
  </ItemGroup>

  <!-- Test fixture files -->
  <ItemGroup>
    <Content Include="TestData\**\*.sol">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
