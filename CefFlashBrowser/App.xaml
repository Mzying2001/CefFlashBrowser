<Application x:Class="CefFlashBrowser.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CefFlashBrowser"
             xmlns:sys="clr-namespace:System;assembly=System"
             xmlns:c="clr-namespace:CefFlashBrowser.Views.Custom"
             xmlns:vm="clr-namespace:CefFlashBrowser.ViewModels"
             xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
             xmlns:infraWpf="clr-namespace:CefFlashBrowser.Infrastructure.Wpf"
             xmlns:converters="clr-namespace:CefFlashBrowser.Views.Converters">
    <Application.Resources>
        <ResourceDictionary>


            <ResourceDictionary.MergedDictionaries>
                <!--Language-->
                <infraWpf:NamedResourceDictionary Name="Language" Source="Assets/Language/zh-CN.xaml"/>

                <!--HandyControl-->
                <infraWpf:NamedResourceDictionary Name="Skin" Source="pack://application:,,,/HandyControl;component/Themes/SkinDefault.xaml"/>
                <infraWpf:NamedResourceDictionary Name="Theme" Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>


            <!--ViewModelLocator-->
            <vm:ViewModelLocator x:Key="Locator"/>


            <!--Application Info-->
            <infraWpf:AppInfo x:Key="AppInfo"/>


            <!--Default window style, set via StyleProperty metadata in App.OnStartup-->
            <Style x:Key="DefaultWindowStyle" TargetType="Window">
                <Setter Property="Background" Value="{DynamicResource RegionBrush}"/>
            </Style>


            <!--Change icon colors according to the theme-->
            <Style TargetType="{x:Type svgc:SvgIcon}">
                <Setter Property="Fill" Value="{DynamicResource PrimaryTextBrush}"/>
            </Style>


            <!--Icon resources-->
            <sys:Uri x:Key="AddIconUri">/Assets/Svgs/add.svg</sys:Uri>
            <sys:Uri x:Key="BackIconUri">/Assets/Svgs/back.svg</sys:Uri>
            <sys:Uri x:Key="CloseIconUri">/Assets/Svgs/close.svg</sys:Uri>
            <sys:Uri x:Key="DownIconUri">/Assets/Svgs/down.svg</sys:Uri>
            <sys:Uri x:Key="EditIconUri">/Assets/Svgs/edit.svg</sys:Uri>
            <sys:Uri x:Key="ExportIconUri">/Assets/Svgs/export.svg</sys:Uri>
            <sys:Uri x:Key="ForwardIconUri">/Assets/Svgs/forward.svg</sys:Uri>
            <sys:Uri x:Key="ImportIconUri">/Assets/Svgs/import.svg</sys:Uri>
            <sys:Uri x:Key="LanguageIconUri">/Assets/Svgs/language.svg</sys:Uri>
            <sys:Uri x:Key="MoreIconUri">/Assets/Svgs/more.svg</sys:Uri>
            <sys:Uri x:Key="MuteIconUri">/Assets/Svgs/mute.svg</sys:Uri>
            <sys:Uri x:Key="MuteModeIconUri">/Assets/Svgs/mute-mode.svg</sys:Uri>
            <sys:Uri x:Key="NewTabIconUri">/Assets/Svgs/new-tab.svg</sys:Uri>
            <sys:Uri x:Key="PageIconUri">/Assets/Svgs/page.svg</sys:Uri>
            <sys:Uri x:Key="PluginIconUri">/Assets/Svgs/plugin.svg</sys:Uri>
            <sys:Uri x:Key="ReloadIconUri">/Assets/Svgs/reload.svg</sys:Uri>
            <sys:Uri x:Key="SearchIconUri">/Assets/Svgs/search.svg</sys:Uri>
            <sys:Uri x:Key="SettingsIconUri">/Assets/Svgs/settings.svg</sys:Uri>
            <sys:Uri x:Key="StarIconUri">/Assets/Svgs/star.svg</sys:Uri>
            <sys:Uri x:Key="SubIconUri">/Assets/Svgs/sub.svg</sys:Uri>
            <sys:Uri x:Key="TrashIconUri">/Assets/Svgs/trash.svg</sys:Uri>
            <sys:Uri x:Key="UpIconUri">/Assets/Svgs/up.svg</sys:Uri>
            <sys:Uri x:Key="VolumeIconUri">/Assets/Svgs/volume.svg</sys:Uri>
            <sys:Uri x:Key="WarningIconUri">/Assets/Svgs/warning.svg</sys:Uri>
            <sys:Uri x:Key="ZoomInIconUri">/Assets/Svgs/zoom-in.svg</sys:Uri>
            <sys:Uri x:Key="ZoomOutIconUri">/Assets/Svgs/zoom-out.svg</sys:Uri>


            <!--Converters-->
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <converters:BinaryToSizeStringConverter x:Key="BinaryToReadableSizeStringConverter" UseReadableSize="True"/>
            <converters:BinaryToSizeStringConverter x:Key="BinaryToSizeStringConverter"/>
            <converters:IntToDoubleConverter x:Key="IntToDoubleConverter"/>
            <converters:LanguageNameConverter x:Key="LanguageNameConverter"/>
            <converters:MultiEqualityConverter x:Key="MultiEqualityConverter"/>
            <converters:ObjectGetTypeConverter x:Key="ObjectGetTypeConverter"/>
            <converters:ObjectToStringConverter x:Key="ObjectToStringConverter"/>
            <converters:MultiplyConverter x:Key="TwoThirdConverter" Multiplier="0.6666666666666667"/>
            <converters:UrlGetFileNameConverter x:Key="UrlGetFileNameConverter"/>
            <converters:WebsiteIconUrlConverter x:Key="WebsiteIconUrlConverter"/>
            <converters:ZoomLevelToScaleConverter x:Key="ZoomLevelToScaleConverter"/>


        </ResourceDictionary>
    </Application.Resources>
</Application>
