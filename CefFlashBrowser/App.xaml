<Application x:Class="CefFlashBrowser.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CefFlashBrowser"
             xmlns:sys="clr-namespace:System;assembly=System"
             xmlns:c="clr-namespace:CefFlashBrowser.Views.Custom"
             xmlns:vm="clr-namespace:CefFlashBrowser.ViewModels"
             xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
             xmlns:infraWpf="clr-namespace:CefFlashBrowser.Infrastructure.Wpf"
             xmlns:converters="clr-namespace:CefFlashBrowser.Views.Converters">
    <Application.Resources>
        <ResourceDictionary>


            <ResourceDictionary.MergedDictionaries>
                <!--Language-->
                <infraWpf:NamedResourceDictionary Name="Language" Source="Assets/Language/zh-CN.xaml"/>

                <!--HandyControl-->
                <infraWpf:NamedResourceDictionary Name="Skin" Source="pack://application:,,,/HandyControl;component/Themes/SkinDefault.xaml"/>
                <infraWpf:NamedResourceDictionary Name="Theme" Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml"/>

                <!--Shared control styles and templates-->
                <ResourceDictionary Source="Themes/ListItems.xaml"/>
                <ResourceDictionary Source="Themes/MenuItems.xaml"/>
            </ResourceDictionary.MergedDictionaries>


            <!--ViewModelLocator-->
            <vm:ViewModelLocator x:Key="Locator"/>


            <!--Application Info-->
            <infraWpf:AppInfo x:Key="AppInfo"/>


            <!--Default window style, set via StyleProperty metadata in App.OnStartup-->
            <Style x:Key="DefaultWindowStyle" TargetType="Window">
                <Setter Property="Background" Value="{DynamicResource RegionBrush}"/>
            </Style>


            <!--Change icon colors according to the theme-->
            <Style TargetType="{x:Type svgc:SvgIcon}">
                <Setter Property="Fill" Value="{DynamicResource PrimaryTextBrush}"/>
            </Style>


            <!--Use the shared SVG as a mask. The presenter can specify a theme brush in Tag.-->
            <DataTemplate x:Key="SharedSvgIconTemplate">
                <Rectangle Width="{Binding Width}"
                           Height="{Binding Height}">
                    <Rectangle.OpacityMask>
                        <VisualBrush Stretch="Uniform" Visual="{Binding}"/>
                    </Rectangle.OpacityMask>
                    <Rectangle.Style>
                        <Style TargetType="Rectangle">
                            <Setter Property="Tag"
                                    Value="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=Tag}"/>
                            <Setter Property="Fill"
                                    Value="{Binding RelativeSource={RelativeSource Mode=Self}, Path=Tag}"/>
                            <Style.Triggers>
                                <Trigger Property="Tag" Value="{x:Null}">
                                    <Setter Property="Fill"
                                            Value="{DynamicResource PrimaryTextBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Rectangle.Style>
                </Rectangle>
            </DataTemplate>


            <!--Icon resources-->
            <sys:Uri x:Key="AddIconUri">/Assets/Icons/add.svg</sys:Uri>
            <sys:Uri x:Key="AppLargeIconUri">/Assets/Icons/icon-large.svg</sys:Uri>
            <sys:Uri x:Key="AppSmallIconUri">/Assets/Icons/icon-small.svg</sys:Uri>
            <sys:Uri x:Key="BackIconUri">/Assets/Icons/back.svg</sys:Uri>
            <sys:Uri x:Key="CloseIconUri">/Assets/Icons/close.svg</sys:Uri>
            <sys:Uri x:Key="DownIconUri">/Assets/Icons/down.svg</sys:Uri>
            <sys:Uri x:Key="EditIconUri">/Assets/Icons/edit.svg</sys:Uri>
            <sys:Uri x:Key="ExportIconUri">/Assets/Icons/export.svg</sys:Uri>
            <sys:Uri x:Key="FlashPlayerIconUri">/Assets/Icons/flash-player.svg</sys:Uri>
            <sys:Uri x:Key="ForwardIconUri">/Assets/Icons/forward.svg</sys:Uri>
            <sys:Uri x:Key="ImportIconUri">/Assets/Icons/import.svg</sys:Uri>
            <sys:Uri x:Key="LanguageIconUri">/Assets/Icons/language.svg</sys:Uri>
            <sys:Uri x:Key="MoreIconUri">/Assets/Icons/more.svg</sys:Uri>
            <sys:Uri x:Key="MuteIconUri">/Assets/Icons/mute.svg</sys:Uri>
            <sys:Uri x:Key="MuteModeIconUri">/Assets/Icons/mute-mode.svg</sys:Uri>
            <sys:Uri x:Key="NewTabIconUri">/Assets/Icons/new-tab.svg</sys:Uri>
            <sys:Uri x:Key="PageIconUri">/Assets/Icons/page.svg</sys:Uri>
            <sys:Uri x:Key="PlayIconUri">/Assets/Icons/play.svg</sys:Uri>
            <sys:Uri x:Key="PluginIconUri">/Assets/Icons/plugin.svg</sys:Uri>
            <sys:Uri x:Key="ReloadIconUri">/Assets/Icons/reload.svg</sys:Uri>
            <sys:Uri x:Key="SearchIconUri">/Assets/Icons/search.svg</sys:Uri>
            <sys:Uri x:Key="SettingsIconUri">/Assets/Icons/settings.svg</sys:Uri>
            <sys:Uri x:Key="StarIconUri">/Assets/Icons/star.svg</sys:Uri>
            <sys:Uri x:Key="StopIconUri">/Assets/Icons/stop.svg</sys:Uri>
            <sys:Uri x:Key="SubIconUri">/Assets/Icons/sub.svg</sys:Uri>
            <sys:Uri x:Key="SwfIconUri">/Assets/Icons/swf.svg</sys:Uri>
            <sys:Uri x:Key="TextSortAscendingIconUri">/Assets/Icons/text-sort-asc.svg</sys:Uri>
            <sys:Uri x:Key="TrashIconUri">/Assets/Icons/trash.svg</sys:Uri>
            <sys:Uri x:Key="UpIconUri">/Assets/Icons/up.svg</sys:Uri>
            <sys:Uri x:Key="VolumeIconUri">/Assets/Icons/volume.svg</sys:Uri>
            <sys:Uri x:Key="WarningIconUri">/Assets/Icons/warning.svg</sys:Uri>
            <sys:Uri x:Key="ZoomInIconUri">/Assets/Icons/zoom-in.svg</sys:Uri>
            <sys:Uri x:Key="ZoomOutIconUri">/Assets/Icons/zoom-out.svg</sys:Uri>


            <!--Converters-->
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <converters:BinaryToSizeStringConverter x:Key="BinaryToReadableSizeStringConverter" UseReadableSize="True"/>
            <converters:BinaryToSizeStringConverter x:Key="BinaryToSizeStringConverter"/>
            <converters:IntToDoubleConverter x:Key="IntToDoubleConverter"/>
            <converters:LanguageNameConverter x:Key="LanguageNameConverter"/>
            <converters:MonospaceFontWeightConverter x:Key="MonospaceFontWeightConverter"/>
            <converters:MultiEqualityConverter x:Key="MultiEqualityConverter"/>
            <converters:ObjectGetTypeConverter x:Key="ObjectGetTypeConverter"/>
            <converters:ObjectToStringConverter x:Key="ObjectToStringConverter"/>
            <converters:MultiplyConverter x:Key="TwoThirdConverter" Multiplier="0.6666666666666667"/>
            <converters:WebsiteIconUrlConverter x:Key="WebsiteIconUrlConverter"/>
            <converters:ZoomLevelToScaleConverter x:Key="ZoomLevelToScaleConverter"/>


        </ResourceDictionary>
    </Application.Resources>
</Application>
