<Window x:Class="CefFlashBrowser.Views.UserScriptManager"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:c="clr-namespace:CefFlashBrowser.Views.Custom"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:behaviors="clr-namespace:CefFlashBrowser.Views.Behaviors"
        xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"

        x:Name="window"
        Width="800"
        Height="500"
        MinWidth="600"
        MinHeight="400"
        AllowDrop="True"
        PreviewDragEnter="ImportFileDragOver"
        PreviewDragOver="ImportFileDragOver"
        PreviewDrop="ImportFileDrop"
        Title="{DynamicResource userScriptManager_title}"
        DataContext="{Binding Source={StaticResource Locator}, Path=UserScriptManagerViewModel}">

    <Window.Resources>
        <ContextMenu x:Key="ScriptContextMenu"
                     Opened="ScriptContextMenuOpened"
                     DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="{DynamicResource common_moveUp}"
                      Command="{Binding MoveUpCommand}"
                      Visibility="{Binding IsReorderingEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <MenuItem Header="{DynamicResource common_moveDown}"
                      Command="{Binding MoveDownCommand}"
                      Visibility="{Binding IsReorderingEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <MenuItem Header="{DynamicResource common_moveToTop}"
                      Command="{Binding MoveToFirstCommand}"
                      Visibility="{Binding IsReorderingEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <MenuItem Header="{DynamicResource common_moveToBottom}"
                      Command="{Binding MoveToLastCommand}"
                      Visibility="{Binding IsReorderingEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <Separator Visibility="{Binding IsReorderingEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <MenuItem Header="{DynamicResource common_delete}"
                      Command="{Binding DeleteCommand}"/>
            <Separator/>
            <MenuItem Header="{DynamicResource userScriptInstall_update}"
                      Command="{Binding UpdateCommand}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <MenuItem Header="{DynamicResource userScriptManager_showDetails}"
                      Command="{Binding ShowDetailsCommand}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
        </ContextMenu>
    </Window.Resources>

    <i:Interaction.Behaviors>
        <behaviors:WindowBehavior x:Name="windowBehavior"/>
    </i:Interaction.Behaviors>

    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+N"
                    Command="{Binding NewCommand}"/>
        <KeyBinding Gesture="Ctrl+S"
                    Command="{Binding SaveCommand}"/>
        <KeyBinding Gesture="Ctrl+W"
                    Command="{Binding ElementName=windowBehavior, Path=CloseWindowCommand}"/>
        <KeyBinding Gesture="Ctrl+F"
                    Command="ApplicationCommands.Find"
                    CommandTarget="{Binding ElementName=sourceEditor, Path=TextArea}"/>
        <KeyBinding Gesture="Ctrl+H"
                    Command="ApplicationCommands.Replace"
                    CommandTarget="{Binding ElementName=sourceEditor, Path=TextArea}"/>
    </Window.InputBindings>

    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Find" CanExecute="CanFindOrReplace" Executed="OpenFindOrReplace"/>
        <CommandBinding Command="ApplicationCommands.Replace" CanExecute="CanFindOrReplace" Executed="OpenFindOrReplace"/>
    </Window.CommandBindings>

    <DockPanel SizeChanged="ContentSizeChanged">
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="{DynamicResource common_file}">
                <MenuItem Header="{DynamicResource userScriptManager_new}"
                          Command="{Binding NewCommand}"
                          InputGestureText="Ctrl+N"/>
                <MenuItem Header="{DynamicResource userScriptManager_installFile}"
                          Command="{Binding ElementName=window, Path=ImportFileCommand}"/>
                <MenuItem Header="{DynamicResource userScriptManager_installUrl}"
                          Command="{Binding ShowUrlCommand}"/>
                <MenuItem Header="{DynamicResource userScriptManager_install}"
                          Command="{Binding InstallCommand}"/>
                <Separator/>
                <MenuItem Header="{DynamicResource common_save}"
                          Command="{Binding SaveCommand}"
                          InputGestureText="Ctrl+S"/>
                <MenuItem Header="{DynamicResource userScriptManager_export}"
                          Command="{Binding ElementName=window, Path=ExportCommand}"/>
                <Separator/>
                <MenuItem Header="{DynamicResource common_delete}"
                          Command="{Binding DeleteCommand}"/>
                <Separator/>
                <MenuItem Header="{DynamicResource common_close}"
                          Command="{Binding ElementName=windowBehavior, Path=CloseWindowCommand}"
                          InputGestureText="Ctrl+W"/>
            </MenuItem>
            <MenuItem Header="{DynamicResource common_editMenu}">
                <MenuItem Header="{DynamicResource common_undo}"
                          Command="ApplicationCommands.Undo"
                          CommandTarget="{Binding ElementName=sourceEditor, Path=TextArea}"/>
                <MenuItem Header="{DynamicResource common_redo}"
                          Command="ApplicationCommands.Redo"
                          CommandTarget="{Binding ElementName=sourceEditor, Path=TextArea}"/>
                <Separator/>
                <MenuItem Header="{DynamicResource common_cut}"
                          Command="ApplicationCommands.Cut"
                          CommandTarget="{Binding ElementName=sourceEditor, Path=TextArea}"/>
                <MenuItem Header="{DynamicResource common_copy}"
                          Command="ApplicationCommands.Copy"
                          CommandTarget="{Binding ElementName=sourceEditor, Path=TextArea}"/>
                <MenuItem Header="{DynamicResource common_paste}"
                          Command="ApplicationCommands.Paste"
                          CommandTarget="{Binding ElementName=sourceEditor, Path=TextArea}"/>
                <MenuItem Header="{DynamicResource common_selectAll}"
                          Command="ApplicationCommands.SelectAll"
                          CommandTarget="{Binding ElementName=sourceEditor, Path=TextArea}"/>
                <Separator/>
                <MenuItem x:Name="findMenuItem" Header="{DynamicResource common_find}"
                          InputGestureText="Ctrl+F" Command="ApplicationCommands.Find"
                          CommandTarget="{Binding ElementName=sourceEditor, Path=TextArea}"/>
                <MenuItem x:Name="replaceMenuItem" Header="{DynamicResource userScriptManager_replace}"
                          InputGestureText="Ctrl+H" Command="ApplicationCommands.Replace"
                          CommandTarget="{Binding ElementName=sourceEditor, Path=TextArea}"/>
                <Separator/>
                <MenuItem x:Name="completeCodeMenuItem" Header="{DynamicResource userScriptManager_completeCode}"
                          InputGestureText="Ctrl+Space" Command="{x:Static c:ScriptEditor.CompleteCodeCommand}"
                          CommandTarget="{Binding ElementName=sourceEditor, Path=TextArea}"/>
            </MenuItem>
            <MenuItem Header="{DynamicResource userScriptManager_view}">
                <MenuItem x:Name="editorSettingsMenuItem"
                          Header="{DynamicResource scriptEditorSettings_menu}"
                          Click="OpenEditorSettings"/>
            </MenuItem>
            <MenuItem Header="{DynamicResource common_script}">
                <MenuItem x:Name="batchUpdateMenuItem"
                          Header="{DynamicResource userScriptBatchUpdate_menu}"
                          IsEnabled="{Binding CanOpenBatchUpdate}"
                          Command="{Binding ElementName=window, Path=OpenBatchUpdateCommand}"/>
                <Separator/>
                <MenuItem x:Name="showDetailsMenuItem"
                          Header="{DynamicResource userScriptManager_showDetails}"
                          Command="{Binding ShowDetailsCommand}"
                          CommandParameter="{Binding SelectedScript}"/>
                <MenuItem Header="{DynamicResource userScriptManager_reload}"
                          Command="{Binding ReloadCommand}"/>
            </MenuItem>
            <MenuItem Header="{DynamicResource userScriptManager_help}">
                <MenuItem Header="{DynamicResource userScriptManager_usageGuide}"
                          Command="{Binding ElementName=window, Path=OpenInDefaultBrowserCommand}"
                          CommandParameter="https://github.com/Mzying2001/MonkeySharp/blob/main/docs/usage-guide.md"/>
                <MenuItem Header="{DynamicResource userScriptManager_aboutMonkeySharp}"
                          Command="{Binding ElementName=window, Path=OpenInDefaultBrowserCommand}"
                          CommandParameter="https://github.com/Mzying2001/MonkeySharp/blob/main/README.md"/>
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock Text="{Binding Status}"
                       TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource PrimaryTextBrush}"/>
        </StatusBar>

        <Border DockPanel.Dock="Top"
                Margin="10,10,10,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowUrlInput}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <DockPanel>
                <Button
                    DockPanel.Dock="Right"
                    Margin="5,0,0,0"
                    Padding="10,0"
                    Content="{DynamicResource common_cancel}"
                    Command="{Binding HideUrlCommand}"/>
                <Button
                    DockPanel.Dock="Right"
                    Margin="5,0,0,0"
                    Padding="10,0"
                    Content="{DynamicResource userScriptManager_load}"
                    Command="{Binding LoadUrlCommand}"/>
                <TextBlock
                    DockPanel.Dock="Left"
                    Margin="0,0,5,0"
                    VerticalAlignment="Center"
                    Text="URL:"
                    Foreground="{DynamicResource PrimaryTextBrush}"/>
                <TextBox Text="{Binding InstallUrl, UpdateSourceTrigger=PropertyChanged}">
                    <i:Interaction.Behaviors>
                        <behaviors:TextBoxSelectAllOnFocus/>
                    </i:Interaction.Behaviors>
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding LoadUrlCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
            </DockPanel>
        </Border>

        <Grid x:Name="scriptLayout" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="scriptListColumn" Width="240" MinWidth="180"/>
                <ColumnDefinition x:Name="scriptSplitterColumn" Width="10"/>
                <ColumnDefinition x:Name="scriptEditorColumn" Width="*" MinWidth="240"/>
            </Grid.ColumnDefinitions>

            <Grid Margin="0,0,0,5">
                <hc:TextBox x:Name="scriptFilter"
                            Padding="28,0,8,0"
                            MaxLength="100"
                            Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                            AutomationProperties.Name="{DynamicResource common_filterPlaceholder}"
                            hc:InfoElement.Placeholder="{DynamicResource common_filterPlaceholder}">
                    <i:Interaction.Behaviors>
                        <behaviors:TextBoxSelectAllOnFocus/>
                    </i:Interaction.Behaviors>
                </hc:TextBox>

                <Grid Margin="8,0,0,0"
                      Width="13"
                      Height="13"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Left"
                      IsHitTestVisible="False">
                    <svgc:SvgIcon UriSource="{StaticResource SearchIconUri}"/>
                </Grid>
            </Grid>

            <ListBox x:Name="scriptList"
                     Grid.Row="1"
                     ItemsSource="{Binding ScriptsView}"
                     SelectedItem="{Binding SelectedScript}"
                     IsSynchronizedWithCurrentItem="False"
                     AllowDrop="True">
                <i:Interaction.Behaviors>
                    <behaviors:ListReorderBehavior
                        IsDragEnabled="{Binding IsReorderingEnabled}"
                        ReorderCommand="{Binding ReorderCommand}"
                        CanReorderItem="{Binding CanReorderItem}"/>
                </i:Interaction.Behaviors>

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem"
                           BasedOn="{StaticResource AppListBoxItemStyle}">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Tag"
                                Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
                        <Setter Property="ContextMenu"
                                Value="{StaticResource ScriptContextMenu}"/>
                        <EventSetter Event="PreviewMouseRightButtonDown"
                                     Handler="ScriptPreviewMouseRightButtonDown"/>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="2,5">
                            <CheckBox DockPanel.Dock="Right"
                                      Margin="8,0,0,0"
                                      VerticalAlignment="Center"
                                      Style="{StaticResource ToggleButtonSwitch}"
                                      IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                      IsEnabled="{Binding IsInstalled}"
                                      ToolTip="{DynamicResource userScriptManager_toggle}"
                                      Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                      CommandParameter="{Binding}"/>

                            <c:BrowserIcon DockPanel.Dock="Left"
                                           Width="24"
                                           Height="24"
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Center"
                                           FaviconUrl="{Binding IconUrl}"
                                           DefaultIcon="{Binding IconInitial}"
                                           Style="{StaticResource {x:Static c:BrowserIcon.TextFallbackStyleKey}}"/>

                            <StackPanel>
                                <DockPanel HorizontalAlignment="Left">
                                    <TextBlock DockPanel.Dock="Right"
                                               Margin="2,0,0,0"
                                               Text="{Binding DirtyMark, Mode=OneWay}"
                                               Foreground="{DynamicResource DangerBrush}"/>
                                    <TextBlock TextTrimming="CharacterEllipsis"
                                               Text="{Binding Name, Mode=OneWay}"/>
                                </DockPanel>

                                <TextBlock Text="{Binding Version}"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           Opacity="0.7">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <Trigger Property="Text" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <TextBlock Foreground="{DynamicResource PrimaryTextBrush}"
                                           Opacity="0.7">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Setter Property="Text" Value="{DynamicResource userScriptManager_draft}"/>
                                                </DataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsInstalled}" Value="True"/>
                                                        <Condition Binding="{Binding IsReady}" Value="False"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Setter Property="Text" Value="{DynamicResource userScriptManager_unavailable}"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock x:Name="scriptListEmptyMessage"
                       Grid.Row="1"
                       Margin="10"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       IsHitTestVisible="False">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Setter Property="Text" Value="{DynamicResource userScriptManager_noMatchingScripts}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Scripts.Count}" Value="0">
                                <Setter Property="Text" Value="{DynamicResource userScriptManager_noInstalledScripts}"/>
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding ElementName=scriptList, Path=HasItems}" Value="False"/>
                                    <Condition Binding="{Binding IsBusy}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <GridSplitter Grid.Column="1"
                          Grid.RowSpan="2"
                          Width="10"
                          Background="Transparent"
                          HorizontalAlignment="Stretch"/>

            <DockPanel Grid.Column="2"
                       Grid.RowSpan="2"
                       PreviewKeyDown="SearchPreviewKeyDown">
                <Border x:Name="searchBar"
                        DockPanel.Dock="Top"
                        Padding="10"
                        BorderThickness="1,1,1,0"
                        Visibility="Collapsed"
                        Background="{DynamicResource SecondaryRegionBrush}"
                        BorderBrush="{DynamicResource BorderBrush}">
                    <Border.Resources>
                        <Style TargetType="Button"
                               BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Height" Value="28"/>
                            <Setter Property="Padding" Value="0"/>
                        </Style>
                    </Border.Resources>

                    <StackPanel>
                        <DockPanel>
                            <Button
                                x:Name="closeSearchButton" DockPanel.Dock="Right" Margin="5,0,0,0"
                                AutomationProperties.Name="Close"
                                Width="{Binding RelativeSource={RelativeSource Mode=Self}, Path=Height}"
                                ToolTip="{DynamicResource common_close}" Click="CloseSearchClicked">
                                <svgc:SvgIcon Width="10" Height="10"
                                              UriSource="{StaticResource CloseIconUri}"/>
                            </Button>
                            <hc:TextBox
                                x:Name="searchText" TextChanged="SearchTextChanged"
                                AutomationProperties.Name="Find"
                                hc:InfoElement.Placeholder="{DynamicResource common_find}">
                                <i:Interaction.Behaviors>
                                    <behaviors:TextBoxSelectAllOnFocus/>
                                </i:Interaction.Behaviors>
                            </hc:TextBox>
                        </DockPanel>
                        <Grid Margin="0,5,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>
                            <Button
                                x:Name="findPrevious" Margin="0,0,5,0" VerticalAlignment="Center"
                                AutomationProperties.Name="PreviousMatch"
                                Width="{Binding RelativeSource={RelativeSource Mode=Self}, Path=Height}"
                                ToolTip="{DynamicResource userScriptManager_findPrevious}" Click="FindMatchClicked">
                                <svgc:SvgIcon Width="12" Height="12"
                                              UriSource="{StaticResource UpIconUri}"/>
                            </Button>
                            <Button
                                x:Name="findNext" Grid.Column="1" VerticalAlignment="Center"
                                AutomationProperties.Name="NextMatch"
                                Width="{Binding RelativeSource={RelativeSource Mode=Self}, Path=Height}"
                                ToolTip="{DynamicResource userScriptManager_findNext}" Click="FindMatchClicked">
                                <svgc:SvgIcon Width="12" Height="12"
                                              UriSource="{StaticResource DownIconUri}"/>
                            </Button>
                            <CheckBox x:Name="matchCase" Grid.Column="2" Margin="10,0,0,0"
                                      HorizontalAlignment="Left" VerticalAlignment="Center"
                                      Content="{DynamicResource userScriptManager_matchCase}"
                                      Checked="MatchCaseChanged" Unchecked="MatchCaseChanged"
                                      AutomationProperties.Name="MatchCase">
                                <CheckBox.ContentTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                                    </DataTemplate>
                                </CheckBox.ContentTemplate>
                            </CheckBox>
                            <Grid Grid.Column="3" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="matchCount" TextWrapping="Wrap" TextAlignment="Right"
                                           Foreground="{DynamicResource SecondaryTextBrush}">
                                    <Run Text="{DynamicResource userScriptManager_matches}"/><Run Text=" "/><Run x:Name="matchCountValue"/>
                                </TextBlock>
                                <TextBlock x:Name="noMatches" TextWrapping="Wrap" TextAlignment="Right"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Text="{DynamicResource userScriptManager_noMatches}">
                                </TextBlock>
                            </Grid>
                        </Grid>
                        <StackPanel x:Name="replaceRow"
                                    Margin="0,5,0,0"
                                    Visibility="Collapsed">
                            <hc:TextBox
                                x:Name="replacementText"
                                AutomationProperties.Name="Replace"
                                hc:InfoElement.Placeholder="{DynamicResource userScriptManager_replace}">
                                <i:Interaction.Behaviors>
                                    <behaviors:TextBoxSelectAllOnFocus/>
                                </i:Interaction.Behaviors>
                            </hc:TextBox>
                            <WrapPanel>
                                <Button
                                    x:Name="replaceCurrent" Margin="0,5,5,0" Padding="10,0"
                                    Content="{DynamicResource userScriptManager_replace}"
                                    AutomationProperties.Name="ReplaceCurrent"
                                    ToolTip="{DynamicResource userScriptManager_replaceCurrent}"
                                    Click="ReplaceCurrentClicked"/>
                                <Button
                                    x:Name="replaceAll" Margin="0,5,0,0" Padding="10,0"
                                    Content="{DynamicResource userScriptManager_replaceAll}"
                                    Click="ReplaceAllClicked"/>
                            </WrapPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border DockPanel.Dock="Bottom"
                        MaxHeight="100"
                        BorderThickness="1,0,1,1"
                        Background="{DynamicResource SecondaryRegionBrush}"
                        BorderBrush="{DynamicResource BorderBrush}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedScript.Problem}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SelectedScript.Problem}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock Margin="10,5"
                                   Text="{Binding SelectedScript.Problem}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                    </ScrollViewer>
                </Border>

                <c:ScriptEditor x:Name="sourceEditor"
                                Padding="4"
                                BorderThickness="1"
                                HorizontalScrollBarVisibility="Auto"
                                VerticalScrollBarVisibility="Auto">
                    <c:ScriptEditor.Style>
                        <Style TargetType="c:ScriptEditor">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedScript}" Value="{x:Null}">
                                    <Setter Property="IsEnabled" Value="False"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </c:ScriptEditor.Style>
                    <c:ScriptEditor.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.TextArea, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="{DynamicResource common_undo}"
                                      Command="ApplicationCommands.Undo"
                                      CommandTarget="{Binding}"/>
                            <MenuItem Header="{DynamicResource common_redo}"
                                      Command="ApplicationCommands.Redo"
                                      CommandTarget="{Binding}"/>
                            <Separator/>
                            <MenuItem Header="{DynamicResource common_cut}"
                                      Command="ApplicationCommands.Cut"
                                      CommandTarget="{Binding}"/>
                            <MenuItem Header="{DynamicResource common_copy}"
                                      Command="ApplicationCommands.Copy"
                                      CommandTarget="{Binding}"/>
                            <MenuItem Header="{DynamicResource common_paste}"
                                      Command="ApplicationCommands.Paste"
                                      CommandTarget="{Binding}"/>
                            <Separator/>
                            <MenuItem Header="{DynamicResource common_selectAll}"
                                      Command="ApplicationCommands.SelectAll"
                                      CommandTarget="{Binding}"/>
                        </ContextMenu>
                    </c:ScriptEditor.ContextMenu>
                </c:ScriptEditor>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
