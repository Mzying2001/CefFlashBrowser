<Window x:Class="CefFlashBrowser.Views.BrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:CefFlashBrowser.Services"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CefFlashBrowser.Views"
        xmlns:m="clr-namespace:CefFlashBrowser.Models"
        xmlns:vm="clr-namespace:CefFlashBrowser.ViewModels"
        xmlns:flash="clr-namespace:CefFlashBrowser.FlashBrowser;assembly=CefFlashBrowser.FlashBrowser"
        xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:c="clr-namespace:CefFlashBrowser.Views.Custom"
        xmlns:behaviors="clr-namespace:CefFlashBrowser.Views.Behaviors"
        mc:Ignorable="d"

        x:Name="window"
        Width="Auto"
        Height="Auto"
        MinWidth="400"
        MinHeight="300"
        Title="{Binding CurrentBrowser.Title, TargetNullValue=FlashBrowser}"
        DataContext="{Binding Source={StaticResource Locator}, Path=BrowserWindowViewModel}">

    <Window.Resources>
        <ControlTemplate x:Key="BrowserIconButtonTemplate" TargetType="Button">
            <Grid Background="{TemplateBinding Background}">
                <Border x:Name="highlight"
                        CornerRadius="4"
                        Opacity="0"
                        Background="{TemplateBinding Foreground}"/>
                <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="highlight" Property="Opacity" Value="0.12"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="highlight" Property="Opacity" Value="0.24"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="highlight" Property="Opacity" Value="0"/>
                    <Setter Property="Opacity" Value="0.4"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!--ConetxtMenu-->
        <!--Browser actions menu-->
        <ContextMenu x:Key="browserActionsMenu"
                     VerticalOffset="-8"
                     HorizontalOffset="8">
            <MenuItem Header="{DynamicResource browser_showMainWindow}"
                      Command="{Binding ShowMainWindowCommand}"
                      InputGestureText="Alt+Home"/>

            <MenuItem Header="{DynamicResource browser_newTab}"
                      Command="{Binding AddBrowserCommand}"
                      InputGestureText="Ctrl+T">
                <MenuItem.Icon>
                    <svgc:SvgIcon Width="12"
                                  Height="12"
                                  UriSource="{StaticResource NewTabIconUri}"/>
                </MenuItem.Icon>
            </MenuItem>

            <MenuItem Header="{DynamicResource browser_newBrowserWindow}"
                      Command="{Binding NewBrowserWindowCommand}"
                      CommandParameter="{Binding CurrentBrowser.Address}"
                      InputGestureText="Ctrl+N">
                <MenuItem.Icon>
                    <svgc:SvgIcon Width="14"
                                  Height="14"
                                  UriSource="{StaticResource PageIconUri}"/>
                </MenuItem.Icon>
            </MenuItem>

            <Separator/>

            <MenuItem Command="{Binding ToggleMuteCommand}"
                      CommandParameter="{Binding CurrentBrowser}"
                      InputGestureText="Ctrl+M">
                <MenuItem.Resources>
                    <svgc:SvgIcon x:Key="muteIcon"
                                  Width="14"
                                  Height="14"
                                  UriSource="{StaticResource MuteModeIconUri}"/>
                    <svgc:SvgIcon x:Key="volumeIcon"
                                  Width="14"
                                  Height="14"
                                  UriSource="{StaticResource VolumeIconUri}"/>
                </MenuItem.Resources>
                <MenuItem.Style>
                    <Style TargetType="MenuItem"
                           BasedOn="{StaticResource {x:Type MenuItem}}">
                        <Setter Property="Header"
                                Value="{DynamicResource browser_muteSite}"/>
                        <Setter Property="Icon"
                                Value="{StaticResource muteIcon}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentBrowser.IsMuted}"
                                         Value="True">
                                <Setter Property="Header"
                                        Value="{DynamicResource browser_unmuteSite}"/>
                                <Setter Property="Icon"
                                        Value="{StaticResource volumeIcon}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.Style>
            </MenuItem>

            <Separator/>

            <MenuItem>
                <MenuItem.Template>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid Margin="{TemplateBinding Padding}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0"
                                              Content="{TemplateBinding Icon}"/>
                            <ContentPresenter Grid.Column="1"
                                              Content="{TemplateBinding Header}"/>
                        </Grid>
                    </ControlTemplate>
                </MenuItem.Template>
                <MenuItem.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   VerticalAlignment="Center">
                            <Run Text="{DynamicResource browser_zoom}"/><Run Text="{Binding CurrentBrowser.ZoomLevel, Converter={StaticResource ZoomLevelToScaleConverter}, StringFormat={}: {0:p0}}"/>
                        </TextBlock>
                        <hc:ButtonGroup Grid.Column="1"
                                        Margin="0,0,43,0"
                                        Orientation="Horizontal">
                            <Button Width="30"
                                    Height="30"
                                    Padding="0"
                                    ToolTip="{DynamicResource browser_toolTipZoomOut}"
                                    Command="{Binding Source={x:Reference Name=window}, Path=DataContext.CurrentBrowser.Browser.ZoomOutCommand}">
                                <svgc:SvgIcon Width="10"
                                              Height="10"
                                              UriSource="{StaticResource SubIconUri}">
                                    <svgc:SvgIcon.LayoutTransform>
                                        <!--disappear when there is only a horzontal line???-->
                                        <RotateTransform Angle="0.01"/>
                                    </svgc:SvgIcon.LayoutTransform>
                                </svgc:SvgIcon>
                            </Button>
                            <Button Width="30"
                                    Height="30"
                                    Padding="0"
                                    ToolTip="{DynamicResource browser_toolTipZoomIn}"
                                    Command="{Binding Source={x:Reference Name=window}, Path=DataContext.CurrentBrowser.Browser.ZoomInCommand}">
                                <svgc:SvgIcon Width="10"
                                              Height="10"
                                              UriSource="{StaticResource AddIconUri}"/>
                            </Button>
                        </hc:ButtonGroup>
                    </Grid>
                </MenuItem.Header>
            </MenuItem>

            <Separator/>

            <MenuItem Header="{DynamicResource common_favorites}"
                      ItemsSource="{Binding Source={StaticResource Locator}, Path=FavoritesService.Favorites}">
                <MenuItem.Icon>
                    <svgc:SvgIcon Width="15"
                                  Height="15"
                                  UriSource="{StaticResource StarIconUri}"/>
                </MenuItem.Icon>
                <MenuItem.Style>
                    <Style TargetType="MenuItem"
                           BasedOn="{StaticResource {x:Type MenuItem}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Source={StaticResource Locator}, Path=FavoritesService.Favorites.Count}"
                                         Value="0">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.Style>
                <MenuItem.ItemContainerStyle>
                    <Style TargetType="MenuItem"
                           BasedOn="{StaticResource {x:Type MenuItem}}">
                        <Style.Resources>
                            <DataTemplate x:Key="{DataTemplateKey {x:Type m:Website}}"
                                          DataType="{x:Type m:Website}">
                                <c:BrowserIcon>
                                    <c:BrowserIcon.FaviconUrl>
                                        <MultiBinding Converter="{StaticResource WebsiteIconUrlConverter}" Mode="OneWay">
                                            <Binding Path="Url"/>
                                            <Binding Source="{StaticResource Locator}" Path="FaviconService"/>
                                            <Binding Source="{StaticResource Locator}" Path="FaviconService.Revision"/>
                                        </MultiBinding>
                                    </c:BrowserIcon.FaviconUrl>
                                </c:BrowserIcon>
                            </DataTemplate>
                        </Style.Resources>
                        <Setter Property="MinWidth" Value="250"/>
                        <Setter Property="MaxWidth" Value="300"/>
                        <Setter Property="Template"
                                Value="{StaticResource MenuItemWithoutShortcutTemplate}"/>
                        <Setter Property="Icon"
                                Value="{Binding}"/>
                        <Setter Property="Command"
                                Value="{Binding Source={x:Reference Name=window}, Path=DataContext.CurrentBrowser.Browser.LoadUrlCommand}"/>
                        <Setter Property="CommandParameter"
                                Value="{Binding Url}"/>
                    </Style>
                </MenuItem.ItemContainerStyle>
                <MenuItem.ItemTemplate>
                    <DataTemplate DataType="{x:Type m:Website}">
                        <TextBlock VerticalAlignment="Center"
                                   HorizontalAlignment="Left"
                                   Text="{Binding Name}"
                                   TextTrimming="CharacterEllipsis"/>
                    </DataTemplate>
                </MenuItem.ItemTemplate>
            </MenuItem>

            <MenuItem Header="{DynamicResource browser_addFavorite}"
                      Command="{Binding AddFavoriteCommand}"
                      CommandParameter="{Binding CurrentBrowser}"
                      InputGestureText="Ctrl+D"/>

            <Separator/>

            <MenuItem Header="{DynamicResource downloads_menu}"
                      Command="{x:Static services:WindowManager.OpenDownloadsCommand}"
                      InputGestureText="Ctrl+J"/>

            <MenuItem Header="{DynamicResource common_manageUserScripts}"
                      Command="{Binding OpenUserScriptManagerCommand}"/>

            <MenuItem Header="{DynamicResource userscript_managePermissions}"
                      Click="OpenUserScriptPermissions"/>

            <Separator/>

            <MenuItem Header="{DynamicResource browser_createShortcut}"
                      Command="{Binding CreateShortcutCommand}"
                      CommandParameter="{Binding CurrentBrowser}"
                      InputGestureText="Ctrl+Shift+S"/>

            <MenuItem Header="{DynamicResource browser_openInDefaultBrowser}"
                      Command="{Binding OpenInDefaultBrowserCommand}"
                      CommandParameter="{Binding CurrentBrowser.Address}"
                      InputGestureText="Ctrl+Shift+O"/>

            <Separator/>

            <MenuItem Header="{DynamicResource browser_toggleDevTool}"
                      Command="{Binding ToggleDevToolsCommand}"
                      CommandParameter="{Binding CurrentBrowser}"
                      InputGestureText="F12"/>

            <MenuItem Header="{DynamicResource browser_viewSource}"
                      Command="{Binding ViewSourceCommand}"
                      CommandParameter="{Binding CurrentBrowser}"
                      InputGestureText="Ctrl+U"/>
        </ContextMenu>

        <!--Script commands menu-->
        <ContextMenu x:Key="scriptCommandsMenu"
                     MinWidth="250"
                     MaxWidth="300"
                     VerticalOffset="-8"
                     HorizontalOffset="8"
                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <ContextMenu.Resources>
                <CollectionViewSource x:Key="scriptCommandGroups" Source="{Binding CurrentBrowser.UserScriptMenus}">
                    <CollectionViewSource.GroupDescriptions>
                        <PropertyGroupDescription PropertyName="ScriptKey"/>
                    </CollectionViewSource.GroupDescriptions>
                </CollectionViewSource>
                <sys:Double x:Key="scriptCommandRowMinHeight">32</sys:Double>
                <Thickness x:Key="scriptCommandTextMargin">36,3,10,3</Thickness>
            </ContextMenu.Resources>
            <ContextMenu.ItemsSource>
                <Binding Source="{StaticResource scriptCommandGroups}"/>
            </ContextMenu.ItemsSource>
            <ContextMenu.GroupStyle>
                <GroupStyle>
                    <GroupStyle.ContainerStyle>
                        <Style TargetType="GroupItem"
                               BasedOn="{StaticResource {x:Type GroupItem}}">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="GroupItem">
                                        <StackPanel>
                                            <ContentPresenter x:Name="PART_Header"/>
                                            <ItemsPresenter/>
                                        </StackPanel>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </GroupStyle.ContainerStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <Grid MinHeight="{StaticResource scriptCommandRowMinHeight}">
                                <c:BrowserIcon
                                    Width="16"
                                    Height="16"
                                    Margin="10,0,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    FaviconUrl="{Binding Items[0].ScriptIconUrl}"
                                    DefaultIcon="{Binding Items[0].ScriptIconInitial}"
                                    Style="{StaticResource {x:Static c:BrowserIcon.TextFallbackStyleKey}}"/>
                                <TextBlock
                                    Margin="{StaticResource scriptCommandTextMargin}"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    TextTrimming="CharacterEllipsis"
                                    Foreground="{DynamicResource PrimaryTextBrush}"
                                    Text="{Binding Items[0].ScriptName}"
                                    ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                            </Grid>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ContextMenu.GroupStyle>
            <ContextMenu.ItemContainerStyle>
                <Style TargetType="MenuItem"
                       BasedOn="{StaticResource {x:Type MenuItem}}">
                    <Setter Property="MinHeight" Value="{StaticResource scriptCommandRowMinHeight}"/>
                    <Setter Property="Header" Value="{Binding Name}"/>
                    <Setter Property="ToolTip" Value="{Binding Description}"/>
                    <Setter Property="Command" Value="{Binding InvokeCommand}"/>
                    <Setter Property="StaysOpenOnClick" Value="{Binding StaysOpenOnClick}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="MenuItem">
                                <Border x:Name="Bd"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="{TemplateBinding hc:BorderElement.CornerRadius}">
                                    <TextBlock Margin="{StaticResource scriptCommandTextMargin}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Text="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ContextMenu.ItemContainerStyle>
        </ContextMenu>

        <!--Page SWFs menu-->
        <ContextMenu x:Key="pageSwfsMenu"
                     MinWidth="250"
                     MaxWidth="300"
                     VerticalOffset="-8"
                     HorizontalOffset="8"
                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                     ItemsSource="{Binding CurrentBrowser.Browser.PageSwfs}"
                     Button.Click="PageSwfDownloadClicked">
            <ContextMenu.ItemContainerStyle>
                <Style TargetType="MenuItem"
                       BasedOn="{StaticResource {x:Type MenuItem}}">
                    <Setter Property="Padding"
                            Value="3,0"/>
                    <Setter Property="Template"
                            Value="{StaticResource MenuItemWithoutShortcutTemplate}"/>
                    <Setter Property="AutomationProperties.Name"
                            Value="{Binding FileName}"/>
                    <Setter Property="ToolTip"
                            Value="{Binding Url}"/>
                    <Setter Property="Command"
                            Value="{Binding DataContext.OpenInSwfPlayerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    <Setter Property="CommandParameter"
                            Value="{Binding}"/>
                </Style>
            </ContextMenu.ItemContainerStyle>
            <ContextMenu.ItemTemplate>
                <DataTemplate>
                    <DockPanel>
                        <Button DockPanel.Dock="Right"
                                AutomationProperties.Name="DownloadSwf"
                                BorderThickness="0"
                                Background="Transparent"
                                Foreground="{DynamicResource PrimaryTextBrush}"
                                Template="{StaticResource BrowserIconButtonTemplate}"
                                ToolTip="{DynamicResource downloads_start}"
                                Command="{Binding DataContext.DownloadPageSwfCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                CommandParameter="{Binding}">
                            <svgc:SvgIcon Width="13"
                                          Height="13"
                                          UriSource="{StaticResource DownloadIconUri}"/>
                        </Button>
                        <TextBlock Margin="0,0,5,0"
                                   Text="{Binding FileName}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                </DataTemplate>
            </ContextMenu.ItemTemplate>
        </ContextMenu>
    </Window.Resources>


    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+J" Command="{x:Static services:WindowManager.OpenDownloadsCommand}"/>
        <!--<KeyBinding Key="Esc"
                    Command="{Binding ElementName=browser, Path=StopCommand}"/>-->
        <KeyBinding Key="F5"
                    Command="{Binding CurrentBrowser.Browser.ReloadCommand}"/>
        <KeyBinding Key="F11"
                    Command="{Binding ToggleFullscreenCommand}"
                    CommandParameter="{Binding CurrentBrowser}"/>
        <KeyBinding Key="F12"
                    Command="{Binding ToggleDevToolsCommand}"
                    CommandParameter="{Binding CurrentBrowser}"/>
        <KeyBinding Gesture="Ctrl+OemPlus"
                    Command="{Binding CurrentBrowser.Browser.ZoomInCommand}"/>
        <KeyBinding Gesture="Ctrl+OemMinus"
                    Command="{Binding CurrentBrowser.Browser.ZoomOutCommand}"/>
        <KeyBinding Gesture="Ctrl+0"
                    Command="{Binding CurrentBrowser.Browser.ZoomResetCommand}"/>
        <KeyBinding Gesture="Ctrl+D"
                    Command="{Binding AddFavoriteCommand}"
                    CommandParameter="{Binding CurrentBrowser}"/>
        <KeyBinding Gesture="Ctrl+F"
                    Command="{Binding OpenFindPopupCommand}"/>
        <KeyBinding Gesture="Ctrl+M"
                    Command="{Binding ToggleMuteCommand}"
                    CommandParameter="{Binding CurrentBrowser}"/>
        <KeyBinding Gesture="Ctrl+N"
                    Command="{Binding NewBrowserWindowCommand}"
                    CommandParameter="{Binding CurrentBrowser.Address}"/>
        <KeyBinding Gesture="Ctrl+R"
                    Command="{Binding CurrentBrowser.Browser.ReloadCommand}"/>
        <KeyBinding Gesture="Ctrl+T"
                    Command="{Binding AddBrowserCommand}"/>
        <KeyBinding Gesture="Ctrl+Tab"
                    Command="{Binding SelectNextBrowserCommand}"/>
        <KeyBinding Gesture="Ctrl+Shift+Tab"
                    Command="{Binding SelectPreviousBrowserCommand}"/>
        <KeyBinding Gesture="Ctrl+PageDown"
                    Command="{Binding SelectNextBrowserCommand}"/>
        <KeyBinding Gesture="Ctrl+PageUp"
                    Command="{Binding SelectPreviousBrowserCommand}"/>
        <KeyBinding Gesture="Ctrl+Shift+O"
                    Command="{Binding OpenInDefaultBrowserCommand}"
                    CommandParameter="{Binding CurrentBrowser.Address}"/>
        <KeyBinding Gesture="Ctrl+P"
                    Command="{Binding CurrentBrowser.Browser.PrintCommand}"/>
        <KeyBinding Gesture="Ctrl+U"
                    Command="{Binding ViewSourceCommand}"
                    CommandParameter="{Binding CurrentBrowser}"/>
        <KeyBinding Gesture="Ctrl+Shift+S"
                    Command="{Binding CreateShortcutCommand}"
                    CommandParameter="{Binding CurrentBrowser}"/>
        <KeyBinding Gesture="Ctrl+W"
                    Command="{Binding CloseBrowserCommand}"
                    CommandParameter="{Binding CurrentBrowser}"/>
        <KeyBinding Gesture="Ctrl+Shift+K"
                    Command="{Binding DuplicateBrowserCommand}"
                    CommandParameter="{Binding CurrentBrowser}"/>
        <KeyBinding Gesture="Alt+Left"
                    Command="{Binding CurrentBrowser.Browser.BackCommand}"/>
        <KeyBinding Gesture="Alt+Right"
                    Command="{Binding CurrentBrowser.Browser.ForwardCommand}"/>
        <KeyBinding Gesture="Alt+Home"
                    Command="{Binding ShowMainWindowCommand}"/>
    </Window.InputBindings>


    <Grid x:Name="mainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
            <DockPanel.Style>
                <Style TargetType="DockPanel">
                    <Setter Property="Margin" Value="10"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowTabStrip}" Value="True">
                            <Setter Property="Margin" Value="10,10,10,5"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Fullscreen}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DockPanel.Style>

            <DockPanel.Resources>
                <Style TargetType="Button"
                       BasedOn="{StaticResource {x:Type Button}}">
                    <Setter Property="Width" Value="30"/>
                    <Setter Property="Height" Value="30"/>
                    <Setter Property="Padding" Value="0"/>
                </Style>
            </DockPanel.Resources>

            <StackPanel DockPanel.Dock="Left"
                        Orientation="Horizontal">
                <Button ToolTip="{DynamicResource browser_toolTipBack}"
                        Command="{Binding CurrentBrowser.Browser.BackCommand}">
                    <svgc:SvgIcon Width="12"
                                  Height="12"
                                  UriSource="{StaticResource BackIconUri}"/>
                </Button>

                <Button ToolTip="{DynamicResource browser_toolTipForward}"
                        Command="{Binding CurrentBrowser.Browser.ForwardCommand}">
                    <svgc:SvgIcon Width="12"
                                  Height="12"
                                  UriSource="{StaticResource ForwardIconUri}"/>
                </Button>

                <Button Margin="10,0,0,0"
                        Command="{Binding ToggleLoadingStateCommand}"
                        CommandParameter="{Binding CurrentBrowser}">
                    <Button.Resources>
                        <svgc:SvgIcon x:Key="reloadIcon"
                                      Width="12"
                                      Height="12"
                                      UriSource="{StaticResource ReloadIconUri}"/>
                        <svgc:SvgIcon x:Key="stopIcon"
                                      Width="10"
                                      Height="10"
                                      UriSource="{StaticResource CloseIconUri}"/>
                    </Button.Resources>
                    <Button.Style>
                        <Style TargetType="Button"
                               BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Content"
                                    Value="{StaticResource stopIcon}"/>
                            <Setter Property="ToolTip"
                                    Value="{DynamicResource browser_toolTipStop}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentBrowser.Browser.IsLoading}"
                                             Value="False">
                                    <Setter Property="Content"
                                            Value="{StaticResource reloadIcon}"/>
                                    <Setter Property="ToolTip"
                                            Value="{DynamicResource browser_toolTipReload}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>

            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal">
                <!--new tab button-->
                <Button x:Name="toolbarNewTabButton"
                        Margin="0,0,10,0"
                        ToolTip="{DynamicResource browser_toolTipNewTab}"
                        Command="{Binding AddBrowserCommand}">
                    <Button.Style>
                        <Style TargetType="Button"
                               BasedOn="{StaticResource {x:Type Button}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowTabStrip}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <svgc:SvgIcon Width="12"
                                  Height="12"
                                  UriSource="{StaticResource NewTabIconUri}"/>
                </Button>

                <!--script commands button-->
                <Button x:Name="toolbarScriptCommandsButton"
                        Margin="0,0,10,0"
                        AutomationProperties.Name="ScriptCommands"
                        ToolTip="{DynamicResource userscript_commands}">
                    <i:Interaction.Behaviors>
                        <behaviors:ContextMenuBehavior Menu="{DynamicResource scriptCommandsMenu}"/>
                    </i:Interaction.Behaviors>
                    <Button.Style>
                        <Style TargetType="Button"
                               BasedOn="{StaticResource {x:Type Button}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentBrowser.UserScriptMenus.Count, FallbackValue=0}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <svgc:SvgIcon Width="13"
                                  Height="13"
                                  UriSource="{StaticResource PluginIconUri}"/>
                </Button>

                <!--page swfs button-->
                <Button x:Name="toolbarPageSwfsButton"
                        Margin="0,0,10,0"
                        AutomationProperties.Name="PageSwfs"
                        ToolTip="{DynamicResource browser_toolTipPageSwfs}">
                    <i:Interaction.Behaviors>
                        <behaviors:ContextMenuBehavior Menu="{DynamicResource pageSwfsMenu}"/>
                    </i:Interaction.Behaviors>
                    <Button.Style>
                        <Style TargetType="Button"
                               BasedOn="{StaticResource {x:Type Button}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentBrowser.Browser.PageSwfs.Count, FallbackValue=0}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <svgc:SvgIcon Width="12"
                                  Height="12"
                                  UriSource="{StaticResource SwfIconUri}"/>
                </Button>

                <!--find button-->
                <ToggleButton x:Name="findButton"
                              Margin="0,0,10,0"
                              Width="30"
                              Height="30"
                              Padding="0"
                              IsChecked="{Binding ShowFindPopup}">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton"
                               BasedOn="{StaticResource {x:Type ToggleButton}}">
                            <Style.Triggers>
                                <Trigger Property="IsChecked" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ToggleButton.Style>
                    <svgc:SvgIcon Width="13"
                                  Height="13"
                                  UriSource="{StaticResource SearchIconUri}"/>
                </ToggleButton>

                <!--menu button-->
                <Button x:Name="toolbarActionsButton"
                        ToolTip="{DynamicResource browser_toolTipMore}">
                    <i:Interaction.Behaviors>
                        <behaviors:ContextMenuBehavior Menu="{DynamicResource browserActionsMenu}"/>
                    </i:Interaction.Behaviors>
                    <svgc:SvgIcon Width="10"
                                  Height="10"
                                  UriSource="{StaticResource MoreIconUri}"/>
                </Button>

                <!--find popup-->
                <Popup x:Name="findPopup"
                       Opened="FindPopupOpened"
                       Closed="FindPopupClosed"
                       IsOpen="{Binding ShowFindPopup, Mode=TwoWay}"
                       Placement="AbsolutePoint"
                       AllowsTransparency="True">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="Opened">
                            <i:InvokeCommandAction Command="{Binding FindNextTextCommand}"
                                                   CommandParameter="{Binding CurrentBrowser}"/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                    <hc:Card>
                        <StackPanel Margin="5"
                                    Orientation="Horizontal">
                            <StackPanel.Resources>
                                <Style TargetType="Button"
                                       BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="BorderThickness" Value="0"/>
                                </Style>
                            </StackPanel.Resources>

                            <TextBox x:Name="findTextBox"
                                     Width="200"
                                     MaxLength="100"
                                     BorderThickness="0"
                                     Text="{Binding TextToFind, UpdateSourceTrigger=PropertyChanged}">
                                <i:Interaction.Behaviors>
                                    <behaviors:TextBoxSelectAllOnFocus/>
                                </i:Interaction.Behaviors>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="TextChanged">
                                        <i:InvokeCommandAction Command="{Binding FindNextTextCommand}"
                                                               CommandParameter="{Binding CurrentBrowser}"/>
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Esc"
                                                Command="{Binding CloseFindPopupCommand}"/>
                                    <KeyBinding Key="Enter"
                                                Command="{Binding FindNextTextCommand}"
                                                CommandParameter="{Binding CurrentBrowser}"/>
                                    <KeyBinding Key="Up"
                                                Command="{Binding FindPrevTextCommand}"
                                                CommandParameter="{Binding CurrentBrowser}"/>
                                    <KeyBinding Key="Down"
                                                Command="{Binding FindNextTextCommand}"
                                                CommandParameter="{Binding CurrentBrowser}"/>
                                </TextBox.InputBindings>
                            </TextBox>

                            <Separator Margin="5,0">
                                <Separator.LayoutTransform>
                                    <RotateTransform Angle="90"/>
                                </Separator.LayoutTransform>
                            </Separator>

                            <Button Command="{Binding FindPrevTextCommand}"
                                    CommandParameter="{Binding CurrentBrowser}">
                                <svgc:SvgIcon Width="13"
                                              Height="13"
                                              UriSource="{StaticResource UpIconUri}"/>
                            </Button>

                            <Button Command="{Binding FindNextTextCommand}"
                                    CommandParameter="{Binding CurrentBrowser}">
                                <svgc:SvgIcon Width="13"
                                              Height="13"
                                              UriSource="{StaticResource DownIconUri}"/>
                            </Button>
                        </StackPanel>
                    </hc:Card>
                </Popup>
            </StackPanel>

            <Grid Margin="10,0"
                  Height="30">
                <!--address-->
                <TextBox x:Name="addressTextBox"
                         Text="{Binding CurrentBrowser.Browser.Address, Mode=OneWay}">
                    <i:Interaction.Behaviors>
                        <behaviors:TextBoxSelectAllOnFocus/>
                    </i:Interaction.Behaviors>
                    <TextBox.Style>
                        <Style TargetType="TextBox"
                               BasedOn="{StaticResource {x:Type TextBox}}">
                            <Setter Property="Padding" Value="35,0,8,0"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowTabStrip}" Value="True">
                                    <Setter Property="Padding" Value="8,0"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter"
                                    Command="{Binding CurrentBrowser.Browser.LoadUrlCommand}"
                                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=TextBox}, Path=Text}"/>
                    </TextBox.InputBindings>
                </TextBox>
                <!--icon-->
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left"
                            IsHitTestVisible="False">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowTabStrip}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <c:BrowserIcon Margin="8,0,5,0"
                                   FaviconUrl="{Binding CurrentBrowser.Browser.FaviconUrl}"/>
                    <Separator Width="20">
                        <Separator.LayoutTransform>
                            <RotateTransform Angle="90"/>
                        </Separator.LayoutTransform>
                    </Separator>
                </StackPanel>
            </Grid>
        </DockPanel>

        <Grid x:Name="tabStrip"
              Grid.Row="1"
              Margin="10,0">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowTabStrip}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Fullscreen}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsClosing}" Value="True">
                            <Setter Property="IsEnabled" Value="False"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid HorizontalAlignment="Left"
                  MaxWidth="{Binding ElementName=tabStrip, Path=ActualWidth}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!--tabs-->
                <c:BrowserTab x:Name="tabList"
                              Foreground="{DynamicResource PrimaryTextBrush}"
                              Background="{DynamicResource RegionBrush}"
                              BorderBrush="{DynamicResource PrimaryBrush}"
                              ItemsSource="{Binding Browsers}"
                              SelectedItem="{Binding CurrentBrowser, Mode=OneWay}"
                              IsDragEnabled="True"
                              RequestMoveItem="TabRequestMoveItem"
                              SelectionChanged="TabSelectionChanged">
                    <c:BrowserTab.Resources>
                        <Style x:Key="BrowserTitleTextBlockStyle" TargetType="TextBlock">
                            <Setter Property="Text" Value="{Binding Title}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Title}" Value="{x:Null}">
                                    <Setter Property="Text" Value="{DynamicResource browser_newTab}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Title}" Value="">
                                    <Setter Property="Text" Value="{DynamicResource browser_newTab}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </c:BrowserTab.Resources>
                    <c:BrowserTab.ItemContainerStyle>
                        <Style TargetType="ListBoxItem"
                               BasedOn="{StaticResource {x:Static c:BrowserTab.ItemContainerStyleKey}}">
                            <Setter Property="Tag"
                                    Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
                            <Setter Property="ToolTip">
                                <Setter.Value>
                                    <StackPanel MaxWidth="500">
                                        <TextBlock TextWrapping="Wrap"
                                                   Style="{StaticResource BrowserTitleTextBlockStyle}"/>
                                        <TextBlock Text="{Binding Address}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    </StackPanel>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="ContextMenu">
                                <Setter.Value>
                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                        <ContextMenu.Resources>
                                            <Style TargetType="MenuItem"
                                                   BasedOn="{StaticResource {x:Type MenuItem}}">
                                                <Setter Property="Tag"
                                                        Value="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            </Style>
                                        </ContextMenu.Resources>
                                        <MenuItem Command="{Binding Tag.ToggleLoadingStateCommand, RelativeSource={RelativeSource Self}}"
                                                  CommandParameter="{Binding}">
                                            <MenuItem.Resources>
                                                <svgc:SvgIcon x:Key="reloadIcon"
                                                              Width="12"
                                                              Height="12"
                                                              UriSource="{StaticResource ReloadIconUri}"/>
                                                <svgc:SvgIcon x:Key="stopIcon"
                                                              Width="10"
                                                              Height="10"
                                                              UriSource="{StaticResource CloseIconUri}"/>
                                            </MenuItem.Resources>
                                            <MenuItem.Style>
                                                <Style TargetType="MenuItem"
                                                       BasedOn="{StaticResource {x:Type MenuItem}}">
                                                    <Setter Property="Header"
                                                            Value="{DynamicResource browser_reload}"/>
                                                    <Setter Property="Icon"
                                                            Value="{StaticResource reloadIcon}"/>
                                                    <Setter Property="InputGestureText"
                                                            Value="Ctrl+R"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Browser.IsLoading}"
                                                                     Value="True">
                                                            <Setter Property="Header"
                                                                    Value="{DynamicResource browser_stop}"/>
                                                            <Setter Property="Icon"
                                                                    Value="{StaticResource stopIcon}"/>
                                                            <Setter Property="InputGestureText"
                                                                    Value="Esc"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </MenuItem.Style>
                                        </MenuItem>
                                        <MenuItem Command="{Binding Tag.ToggleMuteCommand, RelativeSource={RelativeSource Self}}"
                                                  CommandParameter="{Binding}"
                                                  InputGestureText="Ctrl+M">
                                            <MenuItem.Resources>
                                                <svgc:SvgIcon x:Key="muteIcon"
                                                              Width="14"
                                                              Height="14"
                                                              UriSource="{StaticResource MuteModeIconUri}"/>
                                                <svgc:SvgIcon x:Key="volumeIcon"
                                                              Width="14"
                                                              Height="14"
                                                              UriSource="{StaticResource VolumeIconUri}"/>
                                            </MenuItem.Resources>
                                            <MenuItem.Style>
                                                <Style TargetType="MenuItem"
                                                       BasedOn="{StaticResource {x:Type MenuItem}}">
                                                    <Setter Property="Header"
                                                            Value="{DynamicResource browser_muteSite}"/>
                                                    <Setter Property="Icon"
                                                            Value="{StaticResource muteIcon}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMuted}"
                                                                     Value="True">
                                                            <Setter Property="Header"
                                                                    Value="{DynamicResource browser_unmuteSite}"/>
                                                            <Setter Property="Icon"
                                                                    Value="{StaticResource volumeIcon}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </MenuItem.Style>
                                        </MenuItem>
                                        <Separator/>
                                        <MenuItem Header="{DynamicResource browser_closeTab}"
                                                  Command="{Binding Tag.CloseBrowserCommand, RelativeSource={RelativeSource Self}}"
                                                  CommandParameter="{Binding}"
                                                  InputGestureText="Ctrl+W"/>
                                        <MenuItem Header="{DynamicResource browser_closeOtherTabs}"
                                                  Command="{Binding Tag.CloseOtherBrowsersCommand, RelativeSource={RelativeSource Self}}"
                                                  CommandParameter="{Binding}">
                                            <MenuItem.Style>
                                                <Style TargetType="MenuItem"
                                                       BasedOn="{StaticResource {x:Type MenuItem}}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Tag.Browsers.Count, RelativeSource={RelativeSource Self}}" Value="1">
                                                            <Setter Property="IsEnabled" Value="False"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </MenuItem.Style>
                                        </MenuItem>
                                        <Separator/>
                                        <MenuItem Header="{DynamicResource browser_duplicateTab}"
                                                  Command="{Binding Tag.DuplicateBrowserCommand, RelativeSource={RelativeSource Self}}"
                                                  CommandParameter="{Binding}"
                                                  InputGestureText="Ctrl+Shift+K"/>
                                        <MenuItem Header="{DynamicResource browser_openTabInNewWindow}"
                                                  Command="{Binding Tag.NewBrowserWindowCommand, RelativeSource={RelativeSource Self}}"
                                                  CommandParameter="{Binding Address}">
                                            <MenuItem.Icon>
                                                <svgc:SvgIcon Width="14"
                                                              Height="14"
                                                              UriSource="{StaticResource PageIconUri}"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </Setter.Value>
                            </Setter>
                            <EventSetter Event="PreviewMouseDown"
                                         Handler="TabPreviewMouseDown"/>
                        </Style>
                    </c:BrowserTab.ItemContainerStyle>
                    <c:BrowserTab.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:BrowserViewModel}">
                            <DockPanel>
                                <c:BrowserIcon
                                    DockPanel.Dock="Left"
                                    Margin="0,0,6,0"
                                    FaviconUrl="{Binding Browser.FaviconUrl}"/>
                                <svgc:SvgIcon
                                    DockPanel.Dock="Left"
                                    Width="14"
                                    Height="14"
                                    Margin="0,0,4,0"
                                    VerticalAlignment="Center"
                                    UriSource="{StaticResource MuteIconUri}">
                                    <svgc:SvgIcon.Style>
                                        <Style TargetType="svgc:SvgIcon"
                                               BasedOn="{StaticResource {x:Type svgc:SvgIcon}}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </svgc:SvgIcon.Style>
                                </svgc:SvgIcon>
                                <Button
                                    x:Name="closeTabButton"
                                    DockPanel.Dock="Right"
                                    Padding="0"
                                    Margin="4,0,0,0"
                                    Width="20"
                                    Height="20"
                                    BorderThickness="0"
                                    Focusable="False"
                                    Command="{Binding DataContext.CloseBrowserCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="ToolTip" Value="{DynamicResource browser_closeTab}"/>
                                            <Setter Property="Template" Value="{StaticResource BrowserIconButtonTemplate}"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                    <Setter Property="ToolTip" Value="{DynamicResource browser_toolTipCloseTab}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <svgc:SvgIcon
                                        Width="8"
                                        Height="8"
                                        UriSource="{StaticResource CloseIconUri}"/>
                                </Button>
                                <TextBlock
                                    x:Name="tabTitle"
                                    VerticalAlignment="Center"
                                    TextTrimming="CharacterEllipsis"
                                    Style="{StaticResource BrowserTitleTextBlockStyle}"/>
                            </DockPanel>
                        </DataTemplate>
                    </c:BrowserTab.ItemTemplate>
                </c:BrowserTab>

                <!--new tab-->
                <Button x:Name="newTabButton"
                        Grid.Column="1"
                        Width="30"
                        Height="30"
                        Margin="4,0,0,0"
                        Padding="0"
                        Focusable="False"
                        BorderThickness="0"
                        VerticalAlignment="Center"
                        ToolTip="{DynamicResource browser_toolTipNewTab}"
                        Command="{Binding AddBrowserCommand}">
                    <svgc:SvgIcon Width="12"
                                  Height="12"
                                  UriSource="{StaticResource AddIconUri}"/>
                </Button>
            </Grid>
        </Grid>

        <Grid Grid.Row="2"
              local:BrowserView.DevToolsOpened="DevToolsOpened"
              local:BrowserView.DevToolsClosed="DevToolsClosed"
              local:BrowserView.FullscreenChanged="FullscreenChanged"
              local:BrowserView.BrowserDoClose="BrowserDoClose"
              local:BrowserView.BrowserAfterCreated="BrowserAfterCreated"
              local:BrowserView.BrowserPopup="BrowserPopup"
              local:BrowserView.BrowserNewPage="BrowserNewPage">
            <ItemsControl x:Name="browsersControl" ItemsSource="{Binding Browsers}">
                <ItemsControl.Resources>
                    <Style TargetType="{x:Type local:BrowserView}">
                        <!-- Hidden tabs still participate in native hosting and preparation. -->
                        <Setter Property="Visibility" Value="Hidden"/>
                        <Style.Triggers>
                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Converter="{StaticResource MultiEqualityConverter}">
                                        <Binding Path="DataContext" RelativeSource="{RelativeSource Self}"/>
                                        <Binding Path="DataContext.CurrentBrowser" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                    </MultiBinding>
                                </DataTrigger.Binding>
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.Resources>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Grid/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:BrowserViewModel}">
                        <local:BrowserView/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <Popup x:Name="statusPopup"
               StaysOpen="True"
               Placement="Absolute"
               AllowsTransparency="True"
               Opened="StatusPopupOpened"
               MouseEnter="StatusPopupMouseEnter"
               SizeChanged="StatusPopupSizeChanged">
            <Label x:Name="statusPopupContent"
                   Height="22"
                   Padding="5,0"
                   Opacity="0.85"
                   Content="{Binding CurrentBrowser}"
                   IsVisibleChanged="StatusPopupContentIsVisibleChanged"
                   MaxWidth="{Binding ElementName=mainGrid, Path=ActualWidth, Converter={StaticResource TwoThirdConverter}}">
                <Label.Resources>
                    <DataTemplate x:Key="statusTemplate" DataType="{x:Type vm:BrowserViewModel}">
                        <TextBlock Text="{Binding Browser.StatusText}" TextTrimming="CharacterEllipsis"/>
                    </DataTemplate>
                    <DataTemplate x:Key="loadingTemplate" DataType="{x:Type vm:BrowserViewModel}">
                        <TextBlock>
                            <Run Text="{DynamicResource browser_loading}"/><Run Text="{Binding Browser.LoadingProgress, StringFormat={} ({0:p0})}"/>
                        </TextBlock>
                    </DataTemplate>
                </Label.Resources>
                <Label.Style>
                    <Style TargetType="Label"
                           BasedOn="{StaticResource {x:Type Label}}">
                        <Setter Property="ContentTemplate" Value="{StaticResource statusTemplate}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentBrowser.Browser.IsLoading}" Value="True">
                                <Setter Property="ContentTemplate" Value="{StaticResource loadingTemplate}"/>
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding CurrentBrowser.Browser.IsLoading}" Value="False"/>
                                    <Condition Binding="{Binding CurrentBrowser.Browser.StatusText}" Value=""/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Label.Style>
            </Label>
        </Popup>
    </Grid>
</Window>
