<Window x:Class="CefFlashBrowser.Views.BrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CefFlashBrowser.Views"
        xmlns:m="clr-namespace:CefFlashBrowser.Models"
        xmlns:vm="clr-namespace:CefFlashBrowser.ViewModels"
        xmlns:data="clr-namespace:CefFlashBrowser.Data"
        xmlns:flash="clr-namespace:CefFlashBrowser.FlashBrowser;assembly=CefFlashBrowser.FlashBrowser"
        xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:behaviors="clr-namespace:CefFlashBrowser.Views.Behaviors"
        xmlns:converters="clr-namespace:CefFlashBrowser.Views.Converters"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:c="clr-namespace:CefFlashBrowser.Views.Custom"
        mc:Ignorable="d"

        x:Name="window"
        Width="Auto"
        Height="Auto"
        MinWidth="400"
        MinHeight="300"
        Title="{Binding CurrentBrowser.Title, TargetNullValue=FlashBrowser}"
        DataContext="{Binding Source={StaticResource Locator}, Path=BrowserWindowViewModel}">

    <d:Window.DataContext>
        <vm:BrowserWindowViewModel/>
    </d:Window.DataContext>

    <Window.Resources>
        <!--Converters-->
        <converters:MultiplyConverter x:Key="TwoThirdConverter"
                                      Multiplier="0.6666666666666667"/>

        <!--ConetxtMenu-->
        <!--Browser actions menu-->
        <ContextMenu x:Key="browserActionsMenu"
                     VerticalOffset="-8"
                     HorizontalOffset="8">
            <MenuItem Header="{DynamicResource browser_showMainWindow}"
                      Command="{Binding ShowMainWindowCommand}"
                      InputGestureText="Ctrl+M"/>

            <MenuItem Header="{DynamicResource browser_newTab}"
                      Command="{Binding AddBrowserCommand}"
                      InputGestureText="Ctrl+T"/>

            <MenuItem Header="{DynamicResource browser_newBrowserWindow}"
                      Command="{Binding NewBrowserWindowCommand}"
                      CommandParameter="{Binding CurrentBrowser.Address}"
                      InputGestureText="Ctrl+N"/>

            <Separator/>

            <MenuItem>
                <MenuItem.Template>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid Margin="{TemplateBinding Padding}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0"
                                              Content="{TemplateBinding Icon}"/>
                            <ContentPresenter Grid.Column="1"
                                              Content="{TemplateBinding Header}"/>
                        </Grid>
                    </ControlTemplate>
                </MenuItem.Template>
                <MenuItem.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   VerticalAlignment="Center">
                            <Run Text="{DynamicResource browser_zoom}"/><Run Text="{Binding CurrentBrowser.ZoomLevel, Converter={StaticResource ZoomLevelToScaleConverter}, StringFormat={}: {0:p0}}"/>
                        </TextBlock>
                        <hc:ButtonGroup Grid.Column="1"
                                        Margin="0,0,43,0"
                                        Orientation="Horizontal">
                            <Button Width="30"
                                    Height="30"
                                    Padding="0"
                                    ToolTip="{DynamicResource browser_toolTipZoomOut}"
                                    Command="{Binding Source={x:Reference Name=window}, Path=DataContext.CurrentBrowser.Browser.ZoomOutCommand}">
                                <svgc:SvgIcon Width="10"
                                              Height="10"
                                              UriSource="{StaticResource SubIconUri}">
                                    <svgc:SvgIcon.LayoutTransform>
                                        <!--disappear when there is only a horzontal line???-->
                                        <RotateTransform Angle="0.01"/>
                                    </svgc:SvgIcon.LayoutTransform>
                                </svgc:SvgIcon>
                            </Button>
                            <Button Width="30"
                                    Height="30"
                                    Padding="0"
                                    ToolTip="{DynamicResource browser_toolTipZoomIn}"
                                    Command="{Binding Source={x:Reference Name=window}, Path=DataContext.CurrentBrowser.Browser.ZoomInCommand}">
                                <svgc:SvgIcon Width="10"
                                              Height="10"
                                              UriSource="{StaticResource AddIconUri}"/>
                            </Button>
                        </hc:ButtonGroup>
                    </Grid>
                </MenuItem.Header>
            </MenuItem>

            <Separator/>

            <MenuItem Header="{DynamicResource common_favorites}"
                      ItemsSource="{Binding Source={x:Static data:GlobalData.Favorites}}">
                <MenuItem.Style>
                    <Style TargetType="MenuItem"
                           BasedOn="{StaticResource {x:Type MenuItem}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Source={x:Static data:GlobalData.Favorites}, Path=Count}"
                                         Value="0">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.Style>
                <MenuItem.ItemContainerStyle>
                    <Style TargetType="MenuItem"
                           BasedOn="{StaticResource {x:Type MenuItem}}">
                        <!--<Setter Property="Header"
                                Value="{Binding Name}"/>-->
                        <Setter Property="Command"
                                Value="{Binding Source={x:Reference Name=window}, Path=DataContext.CurrentBrowser.Browser.LoadUrlCommand}"/>
                        <Setter Property="CommandParameter"
                                Value="{Binding Url}"/>
                    </Style>
                </MenuItem.ItemContainerStyle>
                <MenuItem.ItemTemplate>
                    <DataTemplate DataType="{x:Type m:Website}">
                        <TextBlock MaxWidth="200"
                                   TextTrimming="CharacterEllipsis"
                                   Text="{Binding Name}"/>
                    </DataTemplate>
                </MenuItem.ItemTemplate>
            </MenuItem>

            <MenuItem Header="{DynamicResource browser_addFavorite}"
                      Command="{Binding AddFavoriteCommand}"
                      CommandParameter="{Binding CurrentBrowser}"
                      InputGestureText="Ctrl+D"/>

            <Separator/>

            <MenuItem Header="{DynamicResource browser_createShortcut}"
                      Command="{Binding CreateShortcutCommand}"
                      CommandParameter="{Binding CurrentBrowser}"
                      InputGestureText="Ctrl+Shift+S"/>

            <MenuItem Header="{DynamicResource browser_openInDefaultBrowser}"
                      Command="{Binding OpenInDefaultBrowserCommand}"
                      CommandParameter="{Binding CurrentBrowser.Address}"
                      InputGestureText="Ctrl+O"/>

            <Separator/>

            <MenuItem Header="{DynamicResource browser_toggleDevTool}"
                      Command="{Binding ToggleDevToolsCommand}"
                      CommandParameter="{Binding CurrentBrowser}"
                      InputGestureText="F12"/>

            <MenuItem Header="{DynamicResource browser_viewSource}"
                      Command="{Binding ViewSourceCommand}"
                      CommandParameter="{Binding CurrentBrowser.Address}"
                      InputGestureText="Ctrl+U"/>
        </ContextMenu>

        <!--Blocked SWFs menu-->
        <ContextMenu x:Key="blockedSwfsMenu"
                     VerticalOffset="-8"
                     HorizontalOffset="8">
            <ContextMenu.ItemContainerStyle>
                <Style TargetType="MenuItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="MenuItem">
                                <ContentPresenter Content="{TemplateBinding Header}"/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ContextMenu.ItemContainerStyle>
            <ContextMenu.ItemsSource>
                <x:Array Type="{x:Type sys:Object}">
                    <TextBlock Margin="35,10"
                               MaxWidth="250"
                               TextWrapping="Wrap"
                               FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               Text="{DynamicResource browser_tipsBlockedSwfs}"/>
                    <ItemsControl ItemsSource="{Binding Source={x:Reference Name=window}, Path=DataContext.CurrentBrowser.Browser.BlockedSwfs}">
                        <ItemsControl.Resources>
                            <Style TargetType="MenuItem"
                                   BasedOn="{StaticResource {x:Type MenuItem}}">
                                <Setter Property="Tag"
                                        Value="{Binding RelativeSource={RelativeSource AncestorType=ContextMenu}, Path=PlacementTarget.DataContext}"/>
                            </Style>
                        </ItemsControl.Resources>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type sys:String}">
                                <MenuItem Command="{Binding RelativeSource={RelativeSource Mode=Self}, Path=Tag.OpenInSwfPlayerCommand}"
                                          CommandParameter="{Binding}">
                                    <MenuItem.Header>
                                        <TextBlock MaxWidth="250"
                                                   TextTrimming="CharacterEllipsis"
                                                   Text="{Binding Converter={StaticResource UrlGetFileNameConverter}}"
                                                   ToolTip="{Binding}"/>
                                    </MenuItem.Header>
                                </MenuItem>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </x:Array>
            </ContextMenu.ItemsSource>
        </ContextMenu>
    </Window.Resources>


    <Window.InputBindings>
        <!--<KeyBinding Key="Esc"
                    Command="{Binding ElementName=browser, Path=StopCommand}"/>-->
        <KeyBinding Key="F5"
                    Command="{Binding CurrentBrowser.Browser.ReloadCommand}"/>
        <KeyBinding Key="F11"
                    Command="{Binding ToggleFullscreenCommand}"
                    CommandParameter="{Binding CurrentBrowser}"/>
        <KeyBinding Key="F12"
                    Command="{Binding ToggleDevToolsCommand}"
                    CommandParameter="{Binding CurrentBrowser}"/>
        <KeyBinding Gesture="Ctrl+OemPlus"
                    Command="{Binding CurrentBrowser.Browser.ZoomInCommand}"/>
        <KeyBinding Gesture="Ctrl+OemMinus"
                    Command="{Binding CurrentBrowser.Browser.ZoomOutCommand}"/>
        <KeyBinding Gesture="Ctrl+0"
                    Command="{Binding CurrentBrowser.Browser.ZoomResetCommand}"/>
        <KeyBinding Gesture="Ctrl+D"
                    Command="{Binding AddFavoriteCommand}"
                    CommandParameter="{Binding CurrentBrowser}"/>
        <KeyBinding Gesture="Ctrl+F"
                    Command="{Binding OpenFindPopupCommand}"/>
        <KeyBinding Gesture="Ctrl+M"
                    Command="{Binding ShowMainWindowCommand}"/>
        <KeyBinding Gesture="Ctrl+N"
                    Command="{Binding NewBrowserWindowCommand}"
                    CommandParameter="{Binding CurrentBrowser.Address}"/>
        <KeyBinding Gesture="Ctrl+T"
                    Command="{Binding AddBrowserCommand}"/>
        <KeyBinding Gesture="Ctrl+Tab"
                    Command="{Binding SelectNextBrowserCommand}"/>
        <KeyBinding Gesture="Ctrl+Shift+Tab"
                    Command="{Binding SelectPreviousBrowserCommand}"/>
        <KeyBinding Gesture="Ctrl+PageDown"
                    Command="{Binding SelectNextBrowserCommand}"/>
        <KeyBinding Gesture="Ctrl+PageUp"
                    Command="{Binding SelectPreviousBrowserCommand}"/>
        <KeyBinding Gesture="Ctrl+O"
                    Command="{Binding OpenInDefaultBrowserCommand}"
                    CommandParameter="{Binding CurrentBrowser.Address}"/>
        <KeyBinding Gesture="Ctrl+P"
                    Command="{Binding CurrentBrowser.Browser.PrintCommand}"/>
        <KeyBinding Gesture="Ctrl+U"
                    Command="{Binding ViewSourceCommand}"
                    CommandParameter="{Binding CurrentBrowser.Address}"/>
        <KeyBinding Gesture="Ctrl+Shift+S"
                    Command="{Binding CreateShortcutCommand}"
                    CommandParameter="{Binding CurrentBrowser}"/>
        <KeyBinding Gesture="Ctrl+W"
                    Command="{Binding CloseBrowserCommand}"
                    CommandParameter="{Binding CurrentBrowser}"/>
        <KeyBinding Gesture="Alt+Left"
                    Command="{Binding CurrentBrowser.Browser.BackCommand}"/>
        <KeyBinding Gesture="Alt+Right"
                    Command="{Binding CurrentBrowser.Browser.ForwardCommand}"/>
    </Window.InputBindings>


    <Grid x:Name="mainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0"
                   Margin="10">
            <DockPanel.Style>
                <Style TargetType="DockPanel">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Fullscreen}"
                                     Value="True">
                            <Setter Property="Visibility"
                                    Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DockPanel.Style>

            <DockPanel.Resources>
                <Style TargetType="Button"
                       BasedOn="{StaticResource {x:Type Button}}">
                    <Setter Property="Width" Value="30"/>
                    <Setter Property="Height" Value="30"/>
                    <Setter Property="Padding" Value="0"/>
                </Style>
            </DockPanel.Resources>

            <StackPanel DockPanel.Dock="Left"
                        Orientation="Horizontal">
                <Button ToolTip="{DynamicResource browser_toolTipBack}"
                        Command="{Binding CurrentBrowser.Browser.BackCommand}">
                    <svgc:SvgIcon Width="12"
                                  Height="12"
                                  UriSource="{StaticResource BackIconUri}"/>
                </Button>

                <Button ToolTip="{DynamicResource browser_toolTipForward}"
                        Command="{Binding CurrentBrowser.Browser.ForwardCommand}">
                    <svgc:SvgIcon Width="12"
                                  Height="12"
                                  UriSource="{StaticResource ForwardIconUri}"/>
                </Button>

                <Button Margin="10,0,0,0"
                        Command="{Binding ToggleLoadingStateCommand}"
                        CommandParameter="{Binding CurrentBrowser}">
                    <Button.Resources>
                        <svgc:SvgIcon x:Key="reloadIcon"
                                      Width="14"
                                      Height="14"
                                      UriSource="{StaticResource ReloadIconUri}"/>
                        <svgc:SvgIcon x:Key="stopIcon"
                                      Width="12"
                                      Height="12"
                                      UriSource="{StaticResource StopIconUri}"/>
                    </Button.Resources>
                    <Button.Style>
                        <Style TargetType="Button"
                               BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Content"
                                    Value="{StaticResource stopIcon}"/>
                            <Setter Property="ToolTip"
                                    Value="{DynamicResource browser_toolTipStop}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentBrowser.Browser.IsLoading}"
                                             Value="False">
                                    <Setter Property="Content"
                                            Value="{StaticResource reloadIcon}"/>
                                    <Setter Property="ToolTip"
                                            Value="{DynamicResource browser_toolTipReload}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>

            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal">
                <!--new tab button-->
                <Button x:Name="toolbarNewTabButton"
                        Margin="0,0,10,0"
                        ToolTip="{DynamicResource browser_newTab}"
                        Command="{Binding AddBrowserCommand}">
                    <Button.Style>
                        <Style TargetType="Button"
                               BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Browsers.Count}" Value="1">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <svgc:SvgIcon Width="12"
                                  Height="12"
                                  UriSource="{StaticResource NewTabIconUri}"/>
                </Button>

                <!--blocked swfs button-->
                <Button Margin="0,0,10,0"
                        ToolTip="{DynamicResource browser_toolTipBlockedSwfs}">
                    <i:Interaction.Behaviors>
                        <behaviors:ContextMenuBehavior Menu="{DynamicResource blockedSwfsMenu}"/>
                    </i:Interaction.Behaviors>
                    <Button.Style>
                        <Style TargetType="Button"
                               BasedOn="{StaticResource {x:Type Button}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentBrowser.Browser.HasBlockedSwfs}"
                                             Value="False">
                                    <Setter Property="Visibility"
                                            Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <svgc:SvgIcon Width="14"
                                  Height="14"
                                  UriSource="{StaticResource WarningIconUri}"/>
                </Button>

                <!--find button-->
                <ToggleButton x:Name="findButton"
                              Margin="0,0,10,0"
                              Width="30"
                              Height="30"
                              Padding="0"
                              IsChecked="{Binding ShowFindPopup}">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton"
                               BasedOn="{StaticResource {x:Type ToggleButton}}">
                            <Style.Triggers>
                                <Trigger Property="IsChecked"
                                         Value="False">
                                    <Setter Property="Visibility"
                                            Value="Collapsed"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ToggleButton.Style>
                    <svgc:SvgIcon Width="13"
                                  Height="13"
                                  UriSource="{StaticResource SearchIconUri}"/>
                </ToggleButton>

                <!--menu button-->
                <Button ToolTip="{DynamicResource browser_toolTipMore}">
                    <i:Interaction.Behaviors>
                        <behaviors:ContextMenuBehavior Menu="{DynamicResource browserActionsMenu}"/>
                    </i:Interaction.Behaviors>
                    <svgc:SvgIcon Width="10"
                                  Height="10"
                                  UriSource="{StaticResource MoreIconUri}"/>
                </Button>

                <!--find popup-->
                <Popup x:Name="findPopup"
                       Opened="FindPopupOpened"
                       Closed="FindPopupClosed"
                       IsOpen="{Binding ShowFindPopup, Mode=TwoWay}"
                       Placement="AbsolutePoint"
                       AllowsTransparency="True">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="Opened">
                            <i:InvokeCommandAction Command="{Binding FindNextTextCommand}"
                                                   CommandParameter="{Binding CurrentBrowser}"/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                    <hc:Card>
                        <StackPanel Margin="5"
                                    Orientation="Horizontal">
                            <StackPanel.Resources>
                                <Style TargetType="Button"
                                       BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="BorderThickness" Value="0"/>
                                </Style>
                            </StackPanel.Resources>

                            <TextBox x:Name="findTextBox"
                                     Width="200"
                                     MaxLength="100"
                                     BorderThickness="0"
                                     Text="{Binding TextToFind, UpdateSourceTrigger=PropertyChanged}">
                                <i:Interaction.Behaviors>
                                    <behaviors:TextBoxSelectAllOnFocus/>
                                </i:Interaction.Behaviors>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="TextChanged">
                                        <i:InvokeCommandAction Command="{Binding FindNextTextCommand}"
                                                               CommandParameter="{Binding CurrentBrowser}"/>
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Esc"
                                                Command="{Binding CloseFindPopupCommand}"/>
                                    <KeyBinding Key="Enter"
                                                Command="{Binding FindNextTextCommand}"
                                                CommandParameter="{Binding CurrentBrowser}"/>
                                    <KeyBinding Key="Up"
                                                Command="{Binding FindPrevTextCommand}"
                                                CommandParameter="{Binding CurrentBrowser}"/>
                                    <KeyBinding Key="Down"
                                                Command="{Binding FindNextTextCommand}"
                                                CommandParameter="{Binding CurrentBrowser}"/>
                                </TextBox.InputBindings>
                            </TextBox>

                            <Separator Margin="5,0">
                                <Separator.LayoutTransform>
                                    <RotateTransform Angle="90"/>
                                </Separator.LayoutTransform>
                            </Separator>

                            <Button Command="{Binding FindPrevTextCommand}"
                                    CommandParameter="{Binding CurrentBrowser}">
                                <svgc:SvgIcon Width="13"
                                              Height="13"
                                              UriSource="{StaticResource UpIconUri}"/>
                            </Button>

                            <Button Command="{Binding FindNextTextCommand}"
                                    CommandParameter="{Binding CurrentBrowser}">
                                <svgc:SvgIcon Width="13"
                                              Height="13"
                                              UriSource="{StaticResource DownIconUri}"/>
                            </Button>
                        </StackPanel>
                    </hc:Card>
                </Popup>
            </StackPanel>

            <Grid Margin="10,0"
                  Height="30">
                <!--address-->
                <TextBox x:Name="addressTextBox"
                         Text="{Binding CurrentBrowser.Browser.Address, Mode=OneWay}">
                    <i:Interaction.Behaviors>
                        <behaviors:TextBoxSelectAllOnFocus/>
                    </i:Interaction.Behaviors>
                    <TextBox.Style>
                        <Style TargetType="TextBox"
                               BasedOn="{StaticResource {x:Type TextBox}}">
                            <Setter Property="Padding" Value="8,0"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Browsers.Count}" Value="1">
                                    <Setter Property="Padding" Value="35,0,8,0"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter"
                                    Command="{Binding CurrentBrowser.Browser.LoadUrlCommand}"
                                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=TextBox}, Path=Text}"/>
                    </TextBox.InputBindings>
                </TextBox>
                <!--icon-->
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left"
                            IsHitTestVisible="False">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Browsers.Count}" Value="1">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <c:BrowserIcon Margin="8,0,5,0"
                                   FaviconUrl="{Binding CurrentBrowser.Browser.FaviconUrl}"/>
                    <Separator Width="20">
                        <Separator.LayoutTransform>
                            <RotateTransform Angle="90"/>
                        </Separator.LayoutTransform>
                    </Separator>
                </StackPanel>
            </Grid>
        </DockPanel>

        <Grid x:Name="tabStrip"
              Grid.Row="1"
              Margin="10,0">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Browsers.Count}" Value="1">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Fullscreen}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsClosing}" Value="True">
                            <Setter Property="IsEnabled" Value="False"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid HorizontalAlignment="Left"
                  MaxWidth="{Binding ElementName=tabStrip, Path=ActualWidth}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!--tabs-->
                <ListBox x:Name="tabList"
                         BorderThickness="0"
                         Background="Transparent"
                         ItemsSource="{Binding Browsers}"
                         SelectedItem="{Binding CurrentBrowser, Mode=OneWay}"
                         SelectionMode="Single"
                         SelectionChanged="TabSelectionChanged"
                         PreviewMouseWheel="TabListPreviewMouseWheel">
                    <ListBox.Template>
                        <ControlTemplate TargetType="ListBox">
                            <ScrollViewer x:Name="tabScrollViewer"
                                          Focusable="False"
                                          CanContentScroll="True"
                                          VerticalScrollBarVisibility="Disabled"
                                          HorizontalScrollBarVisibility="Hidden">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </ControlTemplate>
                    </ListBox.Template>
                    <ListBox.Resources>
                        <ControlTemplate x:Key="tabContainerTemplate"
                                         TargetType="ListBoxItem">
                            <Border CornerRadius="4,4,0,0"
                                    Background="{TemplateBinding Background}">
                                <ContentPresenter Margin="{TemplateBinding Padding}"/>
                            </Border>
                        </ControlTemplate>
                    </ListBox.Resources>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Width"
                                    Value="250"/>
                            <Setter Property="MinHeight"
                                    Value="32"/>
                            <Setter Property="Padding"
                                    Value="6"/>
                            <Setter Property="HorizontalContentAlignment"
                                    Value="Stretch"/>
                            <Setter Property="Background"
                                    Value="Transparent"/>
                            <Setter Property="Foreground"
                                    Value="{DynamicResource PrimaryTextBrush}"/>
                            <Setter Property="Template"
                                    Value="{StaticResource tabContainerTemplate}"/>
                            <Setter Property="ToolTip"
                                    Value="{Binding Address}"/>
                            <EventSetter Event="PreviewMouseDown"
                                         Handler="TabPreviewMouseDown"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource SecondaryRegionBrush}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#30808080"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:BrowserViewModel}">
                            <DockPanel>
                                <c:BrowserIcon
                                    DockPanel.Dock="Left"
                                    Margin="0,0,6,0"
                                    FaviconUrl="{Binding Browser.FaviconUrl}"/>
                                <Button
                                    x:Name="closeTabButton"
                                    DockPanel.Dock="Right"
                                    Padding="0"
                                    Margin="6,0,0,0"
                                    Width="20"
                                    Height="20"
                                    BorderThickness="0"
                                    Focusable="False"
                                    ToolTip="{DynamicResource browser_closeTab}"
                                    Command="{Binding DataContext.CloseBrowserCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Grid Background="{TemplateBinding Background}">
                                                            <Border x:Name="highlight"
                                                                    CornerRadius="4"
                                                                    Background="{TemplateBinding Foreground}"
                                                                    Opacity="0"/>
                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center"/>
                                                        </Grid>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="highlight" Property="Opacity" Value="0.12"/>
                                                            </Trigger>
                                                            <Trigger Property="IsPressed" Value="True">
                                                                <Setter TargetName="highlight" Property="Opacity" Value="0.24"/>
                                                            </Trigger>
                                                            <Trigger Property="IsEnabled" Value="False">
                                                                <Setter TargetName="highlight" Property="Opacity" Value="0"/>
                                                                <Setter Property="Opacity" Value="0.4"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                    <svgc:SvgIcon
                                        Width="8"
                                        Height="8"
                                        UriSource="{StaticResource StopIconUri}"/>
                                </Button>
                                <TextBlock x:Name="tabTitle"
                                    TextTrimming="CharacterEllipsis"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Left"
                                    ToolTip="{Binding Title}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding Title}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Title}" Value="{x:Null}">
                                                    <Setter Property="Text" Value="{DynamicResource browser_newTab}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Title}" Value="">
                                                    <Setter Property="Text" Value="{DynamicResource browser_newTab}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!--new tab-->
                <Button x:Name="newTabButton"
                        Grid.Column="1"
                        Width="30"
                        Height="30"
                        Margin="4,0,0,0"
                        Padding="0"
                        Focusable="False"
                        BorderThickness="0"
                        VerticalAlignment="Center"
                        ToolTip="{DynamicResource browser_newTab}"
                        Command="{Binding AddBrowserCommand}">
                    <svgc:SvgIcon Width="12"
                                  Height="12"
                                  UriSource="{StaticResource AddIconUri}"/>
                </Button>
            </Grid>
        </Grid>

        <Grid Grid.Row="2"
              local:BrowserView.DevToolsOpened="DevToolsOpened"
              local:BrowserView.DevToolsClosed="DevToolsClosed"
              local:BrowserView.FullscreenChanged="FullscreenChanged"
              local:BrowserView.BrowserDoClose="BrowserDoClose"
              local:BrowserView.BrowserAfterCreated="BrowserAfterCreated"
              local:BrowserView.BrowserPopup="BrowserPopup"
              local:BrowserView.BrowserNewPage="BrowserNewPage">
            <ItemsControl x:Name="browsersControl" ItemsSource="{Binding Browsers}">
                <ItemsControl.Resources>
                    <Style TargetType="{x:Type local:BrowserView}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Converter="{StaticResource MultiEqualityConverter}">
                                        <Binding Path="DataContext" RelativeSource="{RelativeSource Self}"/>
                                        <Binding Path="DataContext.CurrentBrowser" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                    </MultiBinding>
                                </DataTrigger.Binding>
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.Resources>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Grid/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:BrowserViewModel}">
                        <local:BrowserView/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <Popup x:Name="statusPopup"
               StaysOpen="True"
               Placement="Absolute"
               AllowsTransparency="True"
               Opened="StatusPopupOpened"
               MouseEnter="StatusPopupMouseEnter"
               SizeChanged="StatusPopupSizeChanged">
            <Label x:Name="statusPopupContent"
                   Height="22"
                   Padding="5,0"
                   Opacity="0.85"
                   Content="{Binding CurrentBrowser}"
                   MaxWidth="{Binding ElementName=mainGrid, Path=ActualWidth, Converter={StaticResource TwoThirdConverter}}">
                <Label.Resources>
                    <DataTemplate x:Key="statusTemplate" DataType="{x:Type vm:BrowserViewModel}">
                        <TextBlock Text="{Binding Browser.StatusText}" TextTrimming="CharacterEllipsis"/>
                    </DataTemplate>
                    <DataTemplate x:Key="loadingTemplate" DataType="{x:Type vm:BrowserViewModel}">
                        <TextBlock>
                            <Run Text="{DynamicResource browser_loading}"/><Run Text="{Binding Browser.LoadingProgress, StringFormat={} ({0:p0})}"/>
                        </TextBlock>
                    </DataTemplate>
                </Label.Resources>
                <Label.Style>
                    <Style TargetType="Label"
                           BasedOn="{StaticResource {x:Type Label}}">
                        <Setter Property="ContentTemplate" Value="{StaticResource statusTemplate}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentBrowser.Browser.IsLoading}" Value="True">
                                <Setter Property="ContentTemplate" Value="{StaticResource loadingTemplate}"/>
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding CurrentBrowser.Browser.IsLoading}" Value="False"/>
                                    <Condition Binding="{Binding CurrentBrowser.Browser.StatusText}" Value=""/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Label.Style>
            </Label>
        </Popup>
    </Grid>
</Window>
