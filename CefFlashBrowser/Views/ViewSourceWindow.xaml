<Window x:Class="CefFlashBrowser.Views.ViewSourceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CefFlashBrowser.Views"
        mc:Ignorable="d"
        
        x:Name="window"
        Title="{Binding ElementName=browserView, Path=ViewModel.Title, TargetNullValue=view-source}"
        Height="Auto"
        Width="Auto">

    <Window.InputBindings>
        <KeyBinding Key="W"
                    Modifiers="Ctrl"
                    Command="{Binding ElementName=browserView, Path=ViewModel.Browser.CloseBrowserCommand}"
                    CommandParameter="True"/>
    </Window.InputBindings>

    <local:BrowserView x:Name="browserView"
                       DevToolsOpened="DevToolsOpened"
                       DevToolsClosed="DevToolsClosed"
                       BrowserDoClose="BrowserDoClose"
                       BrowserAfterCreated="BrowserAfterCreated"
                       BrowserPopup="BrowserPopup"
                       BrowserNewPage="BrowserNewPage"/>
</Window>
