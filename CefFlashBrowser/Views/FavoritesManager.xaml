<Window x:Class="CefFlashBrowser.Views.FavoritesManager"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:data="clr-namespace:CefFlashBrowser.Data"
        xmlns:local="clr-namespace:CefFlashBrowser.Views"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
        xmlns:behaviors="clr-namespace:CefFlashBrowser.Views.Behaviors"
        xmlns:c="clr-namespace:CefFlashBrowser.Views.Custom"
        mc:Ignorable="d"
        
        Width="700"
        Height="450"
        MinWidth="500"
        MinHeight="300"
        WindowStartupLocation="CenterScreen"
        DataContext="{Binding Source={StaticResource Locator}, Path=FavoritesManagerViewModel}"
        Title="{DynamicResource favorites_managerTitle}">

    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+W"
                    Command="{Binding ElementName=windowBehavior, Path=CloseWindowCommand}"/>
    </Window.InputBindings>

    <i:Interaction.Behaviors>
        <behaviors:WindowBehavior x:Name="windowBehavior"/>
    </i:Interaction.Behaviors>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" MinWidth="150" MaxWidth="400"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.ColumnSpan="3"
                    Margin="0,0,0,10"
                    Orientation="Horizontal">
            <Button Command="{Binding AddItemCommand}">
                <StackPanel Orientation="Horizontal">
                    <svgc:SvgIcon
                        Width="12"
                        Height="12"
                        UriSource="{StaticResource AddIconUri}"/>
                    <TextBlock
                        Margin="8,0,0,0"
                        Text="{DynamicResource favorites_add}"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <ListBox x:Name="favoritesList"
                 Grid.Row="1"
                 AllowDrop="True"
                 ItemsSource="{Binding Favorites}"
                 SelectedItem="{Binding SelectedWebsite}">
            <i:Interaction.Behaviors>
                <behaviors:ListReorderBehavior
                    IsDragEnabled="True"
                    ReorderCommand="{Binding ReorderCommand}"/>
            </i:Interaction.Behaviors>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel>
                        <c:BrowserIcon Margin="0,0,8,0">
                            <c:BrowserIcon.FaviconUrl>
                                <MultiBinding Converter="{StaticResource WebsiteIconUrlConverter}" Mode="OneWay">
                                    <Binding Path="Url"/>
                                    <Binding Source="{StaticResource Locator}" Path="FaviconService"/>
                                    <Binding Source="{StaticResource Locator}" Path="FaviconService.Revision"/>
                                </MultiBinding>
                            </c:BrowserIcon.FaviconUrl>
                        </c:BrowserIcon>
                        <TextBlock Text="{Binding Name}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem"
                       BasedOn="{StaticResource AppListBoxItemStyle}">
                    <Setter Property="Tag"
                            Value="{Binding RelativeSource={RelativeSource AncestorType=ListBox}, Path=DataContext}"/>
                    <Setter Property="ContextMenu">
                        <Setter.Value>
                            <ContextMenu>
                                <ContextMenu.Resources>
                                    <Style TargetType="MenuItem"
                                           BasedOn="{StaticResource MenuItemBaseStyle}">
                                        <Setter Property="Tag"
                                                Value="{Binding RelativeSource={RelativeSource AncestorType=ContextMenu}, Path=PlacementTarget.Tag}"/>
                                    </Style>
                                </ContextMenu.Resources>
                                <MenuItem Header="{DynamicResource common_moveToTop}"
                                          Command="{Binding RelativeSource={RelativeSource Mode=Self}, Path=Tag.MoveToTopCommand}"
                                          CommandParameter="{Binding}"/>
                                <MenuItem Header="{DynamicResource common_moveToBottom}"
                                          Command="{Binding RelativeSource={RelativeSource Mode=Self}, Path=Tag.MoveToBottomCommand}"
                                          CommandParameter="{Binding}"/>
                                <Separator/>
                                <MenuItem Header="{DynamicResource common_remove}"
                                          Command="{Binding RelativeSource={RelativeSource Mode=Self}, Path=Tag.RemoveItemCommand}"
                                          CommandParameter="{Binding}"/>
                            </ContextMenu>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>

        <GridSplitter
            Grid.Row="1"
            Grid.Column="1"
            Width="10"
            Background="Transparent"
            VerticalAlignment="Stretch"
            HorizontalAlignment="Center"/>

        <hc:Card Grid.Row="1"
                 Grid.Column="2">
            <hc:Card.Style>
                <Style TargetType="{x:Type hc:Card}"
                       BasedOn="{StaticResource {x:Type hc:Card}}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedWebsite}"
                                     Value="{x:Null}">
                            <Setter Property="IsEnabled" Value="False"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </hc:Card.Style>
            <Grid>
                <Grid.BindingGroup>
                    <BindingGroup x:Name="itemEditingGroup"/>
                </Grid.BindingGroup>

                <StackPanel Width="300"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            TextBox.TextChanged="TextChangedHandler">
                    <hc:TextBox x:Name="nameTextBox"
                                Text="{Binding SelectedWebsite.Name, UpdateSourceTrigger=Explicit}"
                                hc:TitleElement.Title="{DynamicResource common_name}">
                        <i:Interaction.Behaviors>
                            <behaviors:TextBoxSelectAllOnFocus/>
                        </i:Interaction.Behaviors>
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter"
                                        Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=CommitEditCommand}"/>
                        </TextBox.InputBindings>
                    </hc:TextBox>

                    <hc:TextBox x:Name="urlTextBox"
                                Margin="0,5,0,0"
                                Text="{Binding SelectedWebsite.Url, UpdateSourceTrigger=Explicit}"
                                hc:TitleElement.Title="{DynamicResource common_url}">
                        <i:Interaction.Behaviors>
                            <behaviors:TextBoxSelectAllOnFocus/>
                        </i:Interaction.Behaviors>
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter"
                                        Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=CommitEditCommand}"/>
                        </TextBox.InputBindings>
                    </hc:TextBox>

                    <DockPanel Margin="0,20,0,10"
                               LastChildFill="False">
                        <StackPanel DockPanel.Dock="Left"
                                    Orientation="Horizontal">
                            <StackPanel.Resources>
                                <Style TargetType="Button"
                                       BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Width" Value="30"/>
                                    <Setter Property="Height" Value="30"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </StackPanel.Resources>
                            <Button ToolTip="{DynamicResource common_moveUp}"
                                    Command="{Binding MoveUpCommand}"
                                    CommandParameter="{Binding SelectedWebsite}">
                                <svgc:SvgIcon Width="12"
                                              Height="12"
                                              UriSource="{StaticResource UpIconUri}"/>
                            </Button>
                            <Button ToolTip="{DynamicResource common_moveDown}"
                                    Command="{Binding MoveDownCommand}"
                                    CommandParameter="{Binding SelectedWebsite}">
                                <svgc:SvgIcon Width="12"
                                              Height="12"
                                              UriSource="{StaticResource DownIconUri}"/>
                            </Button>
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Right"
                                    Orientation="Horizontal">
                            <StackPanel.Resources>
                                <Style TargetType="Button"
                                       BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="MinWidth" Value="75"/>
                                </Style>
                            </StackPanel.Resources>
                            <Button Content="{DynamicResource common_remove}"
                                    Command="{Binding RemoveItemCommand}"
                                    CommandParameter="{Binding SelectedWebsite}"/>
                            <Button Margin="5,0,0,0"
                                    Content="{DynamicResource common_save}"
                                    Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=CommitEditCommand}"/>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Grid>
        </hc:Card>
    </Grid>
</Window>
