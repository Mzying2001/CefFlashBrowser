<Window x:Class="CefFlashBrowser.Views.Dialogs.UserScriptNotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:behaviors="clr-namespace:CefFlashBrowser.Views.Behaviors"
        Title="{DynamicResource userscript_notification}"
        Width="440"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowActivated="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <i:Interaction.Behaviors>
        <behaviors:WindowBehavior/>
    </i:Interaction.Behaviors>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Image x:Name="notificationImage"
               Width="80"
               Height="80"
               Margin="0,0,0,12"
               Visibility="Collapsed"/>
        <TextBlock x:Name="notificationText"
                   Grid.Row="1"
                   TextWrapping="Wrap"
                   MaxHeight="240"/>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,18,0,0">
            <Button x:Name="closeButton"
                    MinWidth="85"
                    Margin="0,0,10,0"
                    Content="{DynamicResource userscript_notificationClose}"
                    Click="CloseClick"/>
            <Button x:Name="clickButton"
                    MinWidth="110"
                    Content="{DynamicResource userscript_notificationClick}"
                    Click="NotificationClick"
                    Style="{StaticResource ButtonPrimary}"/>
        </StackPanel>
    </Grid>
</Window>
