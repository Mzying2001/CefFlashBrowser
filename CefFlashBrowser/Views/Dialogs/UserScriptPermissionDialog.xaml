<Window x:Class="CefFlashBrowser.Views.Dialogs.UserScriptPermissionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:behaviors="clr-namespace:CefFlashBrowser.Views.Behaviors"
        x:Name="window"
        Title="{DynamicResource userscript_permissionTitle}"
        Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <i:Interaction.Behaviors>
        <behaviors:WindowBehavior/>
    </i:Interaction.Behaviors>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBox x:Name="message" IsReadOnly="True" BorderThickness="0"
                 TextWrapping="Wrap" MaxHeight="240" VerticalScrollBarVisibility="Auto"/>
        <StackPanel Grid.Row="1" Margin="0,20,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="denyRememberButton" MinWidth="100" Margin="0,0,10,0" Content="{DynamicResource userscript_denyRemember}" Click="DenyClick"/>
            <Button x:Name="allowOnceButton" MinWidth="100" Margin="0,0,10,0" Content="{DynamicResource userscript_allowOnce}" Click="AllowOnceClick"/>
            <Button x:Name="allowRememberButton" MinWidth="100" Content="{DynamicResource userscript_allowRemember}" Click="AllowRememberClick" Style="{StaticResource ButtonPrimary}"/>
        </StackPanel>
    </Grid>
</Window>
