<Window x:Class="CefFlashBrowser.Views.Dialogs.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:behaviors="clr-namespace:CefFlashBrowser.Views.Behaviors"
        xmlns:data="clr-namespace:CefFlashBrowser.Data"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
        Title="{DynamicResource about_title}"
        Background="{DynamicResource RegionBrush}"
        Width="480"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FocusManager.FocusedElement="{Binding ElementName=closeButton}">

    <Window.Resources>
        <Style x:Key="AboutActionButton" TargetType="Button">
            <Setter Property="MinHeight" Value="58"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource RegionBrush}"/>
            <Setter Property="FocusVisualStyle">
                <Setter.Value>
                    <Style TargetType="Control">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Control">
                                    <Border Width="2"
                                            Margin="4,10,0,10"
                                            HorizontalAlignment="Left"
                                            CornerRadius="1"
                                            Background="{DynamicResource PrimaryBrush}"/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="surface"
                                CornerRadius="{TemplateBinding hc:BorderElement.CornerRadius}"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="surface" Property="Background" Value="{DynamicResource SecondaryRegionBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="surface" Property="Background" Value="{DynamicResource BorderBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Gesture="Esc"
                    Command="{Binding ElementName=windowBehavior, Path=CloseWindowCommand}"/>
        <KeyBinding Gesture="Ctrl+W"
                    Command="{Binding ElementName=windowBehavior, Path=CloseWindowCommand}"/>
    </Window.InputBindings>

    <i:Interaction.Behaviors>
        <behaviors:WindowBehavior x:Name="windowBehavior"/>
    </i:Interaction.Behaviors>

    <StackPanel Margin="24" KeyboardNavigation.TabNavigation="Cycle">
        <svgc:SvgViewbox
            Width="64"
            Height="64"
            HorizontalAlignment="Center"
            Focusable="False"
            UriSource="{StaticResource AppLargeIconUri}"/>
        <TextBlock
            Margin="0,8,0,0"
            FontSize="23"
            FontWeight="SemiBold"
            Foreground="{DynamicResource PrimaryTextBrush}"
            TextAlignment="Center"
            Text="{Binding Source={StaticResource AppInfo}, Path=Name, Mode=OneTime}"/>
        <TextBlock
            x:Name="versionText"
            Margin="0,2,0,0"
            Foreground="{DynamicResource SecondaryTextBrush}"
            TextAlignment="Center"
            Text="{Binding Source={StaticResource AppInfo}, Path=Version, Mode=OneTime, StringFormat='v{0}'}"/>
        <TextBlock
            Margin="0,10,0,20"
            Foreground="{DynamicResource SecondaryTextBrush}"
            TextAlignment="Center"
            TextWrapping="Wrap"
            Text="{DynamicResource about_description}"/>

        <Border CornerRadius="6"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                UseLayoutRounding="True">
            <StackPanel>
                <Button x:Name="repositoryButton"
                        AutomationProperties.Name="OpenGitHub"
                        hc:BorderElement.CornerRadius="5,5,0,0"
                        Style="{StaticResource AboutActionButton}"
                        Click="OnOpenRepository">
                    <DockPanel>
                        <ContentControl DockPanel.Dock="Left" Margin="0,0,12,0" VerticalAlignment="Center"
                                        Focusable="False" ContentTemplate="{StaticResource SharedSvgIconTemplate}">
                            <svgc:SvgViewbox Width="20" Height="20" UriSource="{StaticResource GitHubIconUri}"/>
                        </ContentControl>
                        <StackPanel>
                            <TextBlock
                                FontWeight="SemiBold" Text="{DynamicResource about_repository}"/>
                            <TextBlock
                                x:Name="repositoryUrl"
                                Margin="0,3,0,0"
                                TextWrapping="Wrap"
                                Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </StackPanel>
                    </DockPanel>
                </Button>

                <Border Height="1" Background="{DynamicResource BorderBrush}"/>

                <Button x:Name="dataFolderButton"
                        AutomationProperties.Name="OpenDataFolder"
                        hc:BorderElement.CornerRadius="0,0,5,5"
                        Style="{StaticResource AboutActionButton}"
                        Click="OnOpenDataFolder">
                    <DockPanel>
                        <ContentControl DockPanel.Dock="Left" Margin="0,0,12,0" VerticalAlignment="Center"
                                        Focusable="False" ContentTemplate="{StaticResource SharedSvgIconTemplate}">
                            <svgc:SvgViewbox Width="20" Height="20" UriSource="{StaticResource FolderIconUri}"/>
                        </ContentControl>
                        <StackPanel>
                            <TextBlock
                                FontWeight="SemiBold" Text="{DynamicResource about_dataFolder}"/>
                            <TextBlock
                                x:Name="dataPathText"
                                Margin="0,3,0,0"
                                Text="{x:Static data:GlobalData.DataPath}"
                                TextWrapping="Wrap"
                                Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </StackPanel>
                    </DockPanel>
                </Button>
            </StackPanel>
        </Border>

        <StackPanel Margin="0,18,0,0" TextBlock.Foreground="{DynamicResource SecondaryTextBrush}">
            <TextBlock TextAlignment="Center" TextWrapping="Wrap">
                <TextBlock.Text>
                    <MultiBinding StringFormat="{}{0} {1}" Mode="OneTime">
                        <Binding Source="{StaticResource AppInfo}" Path="Copyright"/>
                        <Binding Source="{StaticResource AppInfo}" Path="Company"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
            <TextBlock Margin="0,2,0,0" TextAlignment="Center" Text="{DynamicResource about_license}"/>
        </StackPanel>

        <Button
            x:Name="closeButton"
            Margin="0,18,0,0"
            MinWidth="84"
            Padding="12,0"
            HorizontalAlignment="Right"
            IsDefault="True"
            Style="{StaticResource ButtonPrimary}"
            Content="{DynamicResource common_close}"
            Command="{Binding ElementName=windowBehavior, Path=CloseWindowCommand}"/>
    </StackPanel>
</Window>
