<Window x:Class="CefFlashBrowser.Views.Dialogs.DownloadDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:behaviors="clr-namespace:CefFlashBrowser.Views.Behaviors"
        
        Title="{DynamicResource downloads_new}"
        Width="600"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource RegionBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{DynamicResource downloads_url}" Margin="0,0,0,6"/>
        <TextBox x:Name="urlBox"
                 Grid.Row="1"
                 TextChanged="UrlChanged"
                 Margin="0,0,0,14">
            <i:Interaction.Behaviors>
                <behaviors:TextBoxSelectAllOnFocus/>
            </i:Interaction.Behaviors>
        </TextBox>
        <TextBlock Grid.Row="2" Text="{DynamicResource downloads_savePath}" Margin="0,0,0,6"/>

        <DockPanel Grid.Row="3">
            <Button DockPanel.Dock="Right"
                    Content="{DynamicResource downloads_browse}"
                    Click="Browse"
                    Margin="8,0,0,0"/>
            <TextBox x:Name="pathBox">
                <i:Interaction.Behaviors>
                    <behaviors:TextBoxSelectAllOnFocus/>
                </i:Interaction.Behaviors>
            </TextBox>
        </DockPanel>

        <CheckBox x:Name="rememberBox"
                  Grid.Row="4"
                  Content="{DynamicResource downloads_rememberDirectory}"
                  Margin="0,14,0,16"/>

        <Grid Grid.Row="5">
            <Button x:Name="systemDownloadButton"
                    Content="{DynamicResource downloads_systemDownload}"
                    Click="SystemDownload"
                    HorizontalAlignment="Left"
                    MinWidth="85"
                    Visibility="Collapsed"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="downloadButton"
                        Content="{DynamicResource downloads_start}"
                        Click="StartDownload"
                        IsDefault="True"
                        MinWidth="85"/>
                <Button x:Name="cancelButton"
                        Content="{DynamicResource common_cancel}"
                        Click="Cancel"
                        IsCancel="True"
                        MinWidth="85"
                        Margin="8,0,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
