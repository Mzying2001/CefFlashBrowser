<Window x:Class="CefFlashBrowser.Views.Dialogs.UserScriptInstallDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:behaviors="clr-namespace:CefFlashBrowser.Views.Behaviors"
        xmlns:c="clr-namespace:CefFlashBrowser.Views.Custom"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="{DynamicResource userScriptManager_confirmInstall}"
        Background="{DynamicResource RegionBrush}"
        Width="540"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FocusManager.FocusedElement="{Binding ElementName=installButton}">

    <Window.Resources>
        <Style x:Key="DetailLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,6,12,0"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="DetailValue" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+W"
                    Command="{Binding ElementName=windowBehavior, Path=CloseWindowCommand}"/>
        <KeyBinding Gesture="Esc"
                    Command="{Binding ElementName=windowBehavior, Path=SetDialogResultCommand}">
            <KeyBinding.CommandParameter>
                <sys:Boolean>False</sys:Boolean>
            </KeyBinding.CommandParameter>
        </KeyBinding>
    </Window.InputBindings>

    <i:Interaction.Behaviors>
        <behaviors:WindowBehavior x:Name="windowBehavior"/>
    </i:Interaction.Behaviors>

    <DockPanel Margin="20" KeyboardNavigation.TabNavigation="Cycle">
        <StackPanel DockPanel.Dock="Bottom"
                    Margin="0,18,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button x:Name="cancelButton"
                    MinWidth="84"
                    Padding="12,0"
                    Content="{DynamicResource dialog_cancel}"
                    Command="{Binding ElementName=windowBehavior, Path=SetDialogResultCommand}">
                <Button.CommandParameter>
                    <sys:Boolean>False</sys:Boolean>
                </Button.CommandParameter>
            </Button>
            <Button x:Name="installButton"
                    Margin="8,0,0,0"
                    MinWidth="84"
                    Padding="12,0"
                    IsDefault="True"
                    Style="{StaticResource ButtonPrimary}"
                    Content="{DynamicResource userScriptInstall_install}"
                    Command="{Binding ElementName=windowBehavior, Path=SetDialogResultCommand}">
                <Button.CommandParameter>
                    <sys:Boolean>True</sys:Boolean>
                </Button.CommandParameter>
            </Button>
        </StackPanel>

        <ScrollViewer x:Name="scriptDetails"
                      MaxHeight="384"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <DockPanel>
                    <c:BrowserIcon x:Name="scriptIcon"
                                   DockPanel.Dock="Left"
                                   Width="48"
                                   Height="48"
                                   Margin="0,0,12,0"
                                   VerticalAlignment="Top"
                                   Style="{StaticResource {x:Static c:BrowserIcon.TextFallbackStyleKey}}"/>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="scriptName"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="scriptVersion"
                                   Margin="0,2,0,0"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </DockPanel>

                <TextBlock x:Name="scriptDescription"
                           Margin="0,12,0,0"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           TextWrapping="Wrap"/>

                <Border Margin="0,14,0,0"
                        Padding="0,6,0,0"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="144"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="authorLabel" Style="{StaticResource DetailLabel}" Text="{DynamicResource userScriptInstall_author}"/>
                        <TextBlock x:Name="scriptAuthor" Grid.Column="1" Style="{StaticResource DetailValue}"/>

                        <TextBlock Grid.Row="1" Style="{StaticResource DetailLabel}" Text="{DynamicResource userScriptInstall_source}"/>
                        <TextBox x:Name="scriptOrigin" Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" Padding="0" BorderThickness="0"
                                 IsReadOnly="True" TextWrapping="Wrap" Background="Transparent" Foreground="{DynamicResource PrimaryTextBrush}"/>

                        <TextBlock x:Name="matchesLabel" Grid.Row="2" Style="{StaticResource DetailLabel}" Text="{DynamicResource userScriptManager_match}"/>
                        <TextBlock x:Name="scriptMatches" Grid.Row="2" Grid.Column="1" Style="{StaticResource DetailValue}"/>

                        <TextBlock x:Name="worldLabel" Grid.Row="3" Style="{StaticResource DetailLabel}" Text="{DynamicResource userScriptManager_world}"/>
                        <TextBlock x:Name="scriptWorld" Grid.Row="3" Grid.Column="1" Style="{StaticResource DetailValue}"/>

                        <TextBlock x:Name="grantsLabel" Grid.Row="4" Style="{StaticResource DetailLabel}" Text="{DynamicResource userScriptManager_grants}"/>
                        <TextBlock x:Name="scriptGrants" Grid.Row="4" Grid.Column="1" Style="{StaticResource DetailValue}"/>

                        <TextBlock x:Name="connectsLabel" Grid.Row="5" Style="{StaticResource DetailLabel}" Text="@connect"/>
                        <TextBlock x:Name="scriptConnects" Grid.Row="5" Grid.Column="1" Style="{StaticResource DetailValue}"/>

                        <TextBlock x:Name="requiresLabel" Grid.Row="6" Style="{StaticResource DetailLabel}" Text="@require"/>
                        <TextBlock x:Name="scriptRequires" Grid.Row="6" Grid.Column="1" Style="{StaticResource DetailValue}"/>

                        <TextBlock x:Name="resourcesLabel" Grid.Row="7" Style="{StaticResource DetailLabel}" Text="@resource"/>
                        <TextBlock x:Name="scriptResources" Grid.Row="7" Grid.Column="1" Style="{StaticResource DetailValue}"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
