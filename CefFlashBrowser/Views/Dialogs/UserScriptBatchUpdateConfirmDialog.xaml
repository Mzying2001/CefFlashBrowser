<Window x:Class="CefFlashBrowser.Views.Dialogs.UserScriptBatchUpdateConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:CefFlashBrowser.Views.Behaviors"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="{DynamicResource userScriptBatchUpdate_title}"
        Width="500"
        Height="400"
        MinWidth="460"
        MinHeight="280"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FocusManager.FocusedElement="{Binding ElementName=updateButton}">

    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+W"
                    Command="{Binding ElementName=windowBehavior, Path=CloseWindowCommand}"/>
        <KeyBinding Gesture="Esc"
                    Command="{Binding ElementName=windowBehavior, Path=SetDialogResultCommand}">
            <KeyBinding.CommandParameter>
                <sys:Boolean>False</sys:Boolean>
            </KeyBinding.CommandParameter>
        </KeyBinding>
    </Window.InputBindings>

    <i:Interaction.Behaviors>
        <behaviors:WindowBehavior x:Name="windowBehavior"/>
    </i:Interaction.Behaviors>

    <DockPanel Margin="20" KeyboardNavigation.TabNavigation="Cycle">
        <TextBlock x:Name="confirmationPrompt" DockPanel.Dock="Top" Margin="0,0,0,12"
                   FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"
                   Text="{DynamicResource userScriptBatchUpdate_confirmAll}"/>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0"
                    Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="cancelButton" MinWidth="84" Padding="12,0"
                    Content="{DynamicResource common_cancel}"
                    Command="{Binding ElementName=windowBehavior, Path=SetDialogResultCommand}">
                <Button.CommandParameter>
                    <sys:Boolean>False</sys:Boolean>
                </Button.CommandParameter>
            </Button>
            <Button x:Name="updateButton" Margin="8,0,0,0" MinWidth="84" Padding="12,0"
                    Content="{DynamicResource userScriptBatchUpdate_all}" Style="{StaticResource ButtonPrimary}"
                    IsDefault="True" Command="{Binding ElementName=windowBehavior, Path=SetDialogResultCommand}">
                <Button.CommandParameter>
                    <sys:Boolean>True</sys:Boolean>
                </Button.CommandParameter>
            </Button>
        </StackPanel>

        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
            <ScrollViewer x:Name="scriptScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="scriptList" ItemsSource="{Binding}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="12,8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap"/>
                                    <TextBlock Margin="0,2,0,0" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0} → {1}">
                                                <Binding Path="CurrentVersion" TargetNullValue="—"/>
                                                <Binding Path="NewVersion" TargetNullValue="—"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}"
                                               Text="{DynamicResource userScriptBatchUpdate_overwriteEdits}"
                                               Visibility="{Binding HasUnsavedEdits, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
