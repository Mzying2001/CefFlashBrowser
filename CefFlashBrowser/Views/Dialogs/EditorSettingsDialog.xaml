<Window x:Class="CefFlashBrowser.Views.Dialogs.EditorSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource scriptEditorSettings_title}"
        Width="480"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource RegionBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        FocusManager.FocusedElement="{Binding ElementName=fontFamilyBox}">

    <Window.Resources>
        <Style x:Key="SettingsSection" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SecondaryRegionBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="16,14"/>
        </Style>
        <Style x:Key="SettingsHeading" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="SettingsCaption" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,20,0"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="20" Grid.IsSharedSizeScope="True">
        <Border Style="{StaticResource SettingsSection}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="EditorSettingCaptions"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.ColumnSpan="2" Style="{StaticResource SettingsHeading}"
                           Text="{DynamicResource scriptEditorSettings_display}"/>
                <TextBlock x:Name="fontFamilyCaption" Grid.Row="1" Style="{StaticResource SettingsCaption}"
                           Text="{DynamicResource scriptEditorSettings_fontFamily}"/>
                <ComboBox x:Name="fontFamilyBox" Grid.Row="1" Grid.Column="1"
                          MaxDropDownHeight="320"
                          AutomationProperties.LabeledBy="{Binding ElementName=fontFamilyCaption}"/>
                <TextBlock x:Name="fontSizeCaption" Grid.Row="2" Style="{StaticResource SettingsCaption}"
                           Margin="0,10,20,0" Text="{DynamicResource scriptEditorSettings_fontSize}"/>
                <TextBox x:Name="fontSizeBox" Grid.Row="2" Grid.Column="1" Margin="0,10,0,0"
                         Width="80" HorizontalAlignment="Left"
                         AutomationProperties.LabeledBy="{Binding ElementName=fontSizeCaption}"/>
                <CheckBox x:Name="lineNumbersBox" Grid.Row="3" Grid.ColumnSpan="2" Margin="0,14,0,0"
                          Content="{DynamicResource scriptEditorSettings_lineNumbers}"/>
                <CheckBox x:Name="wordWrapBox" Grid.Row="4" Grid.ColumnSpan="2" Margin="0,8,0,0"
                          Content="{DynamicResource scriptEditorSettings_wordWrap}"/>
            </Grid>
        </Border>

        <Border Style="{StaticResource SettingsSection}" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="EditorSettingCaptions"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.ColumnSpan="2" Style="{StaticResource SettingsHeading}"
                           Text="{DynamicResource scriptEditorSettings_indentation}"/>
                <TextBlock x:Name="indentationCaption" Grid.Row="1" Style="{StaticResource SettingsCaption}"
                           Text="{DynamicResource scriptEditorSettings_indentWith}"/>
                <ComboBox x:Name="indentationBox" Grid.Row="1" Grid.Column="1"
                          AutomationProperties.LabeledBy="{Binding ElementName=indentationCaption}">
                    <ComboBoxItem x:Name="spacesOption" Content="{DynamicResource scriptEditorSettings_spaces}"/>
                    <ComboBoxItem x:Name="tabsOption" Content="{DynamicResource scriptEditorSettings_tabs}"/>
                </ComboBox>
                <TextBlock x:Name="tabWidthCaption" Grid.Row="2" Style="{StaticResource SettingsCaption}"
                           Margin="0,10,20,0" Text="{DynamicResource scriptEditorSettings_tabWidth}"/>
                <TextBox x:Name="tabWidthBox" Grid.Row="2" Grid.Column="1" Margin="0,10,0,0"
                         Width="80" HorizontalAlignment="Left"
                         AutomationProperties.LabeledBy="{Binding ElementName=tabWidthCaption}"/>
            </Grid>
        </Border>

        <TextBlock x:Name="validationMessage" Margin="0,12,0,0"
                   Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"
                   Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="cancelButton" Content="{DynamicResource common_cancel}"
                    IsCancel="True" Click="Cancel" MinWidth="85"/>
            <Button x:Name="okButton" Content="{DynamicResource common_ok}"
                    IsDefault="True" Click="Accept" MinWidth="85" Margin="8,0,0,0"
                    Style="{StaticResource ButtonPrimary}"/>
        </StackPanel>
    </StackPanel>
</Window>
