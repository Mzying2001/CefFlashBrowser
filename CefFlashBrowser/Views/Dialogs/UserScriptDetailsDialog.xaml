<Window x:Class="CefFlashBrowser.Views.Dialogs.UserScriptDetailsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:behaviors="clr-namespace:CefFlashBrowser.Views.Behaviors"
        xmlns:c="clr-namespace:CefFlashBrowser.Views.Custom"
        Title="{DynamicResource userScriptDetails_title}"
        Background="{DynamicResource RegionBrush}"
        Width="540"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FocusManager.FocusedElement="{Binding ElementName=closeButton}">

    <Window.Resources>
        <DataTemplate x:Key="MetadataRowTemplate">
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="144"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,12,0"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           TextWrapping="Wrap"
                           Text="{Binding Key, Mode=OneWay}"/>
                <TextBox Grid.Column="1"
                         Padding="0"
                         BorderThickness="0"
                         Background="Transparent"
                         Foreground="{DynamicResource PrimaryTextBrush}"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         Text="{Binding Value, Mode=OneWay}"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+W"
                    Command="{Binding ElementName=windowBehavior, Path=CloseWindowCommand}"/>
        <KeyBinding Gesture="Esc"
                    Command="{Binding ElementName=windowBehavior, Path=CloseWindowCommand}"/>
    </Window.InputBindings>

    <i:Interaction.Behaviors>
        <behaviors:WindowBehavior x:Name="windowBehavior"/>
    </i:Interaction.Behaviors>

    <DockPanel Margin="20" KeyboardNavigation.TabNavigation="Cycle">
        <Button x:Name="closeButton"
                DockPanel.Dock="Bottom"
                Margin="0,18,0,0"
                MinWidth="84"
                Padding="12,0"
                HorizontalAlignment="Right"
                IsDefault="True"
                Style="{StaticResource ButtonPrimary}"
                Content="{DynamicResource common_close}"
                Command="{Binding ElementName=windowBehavior, Path=CloseWindowCommand}"/>

        <ScrollViewer x:Name="scriptDetails"
                      MaxHeight="384"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <DockPanel>
                    <c:BrowserIcon x:Name="scriptIcon"
                                   DockPanel.Dock="Left"
                                   Width="48"
                                   Height="48"
                                   Margin="0,0,12,0"
                                   VerticalAlignment="Top"
                                   Style="{StaticResource {x:Static c:BrowserIcon.TextFallbackStyleKey}}"/>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="scriptName"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="scriptVersion"
                                   Margin="0,2,0,0"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </DockPanel>

                <TextBlock x:Name="scriptDescription"
                           Margin="0,12,0,0"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           TextWrapping="Wrap"/>

                <TextBlock x:Name="invalidMetadata"
                           Margin="0,14,0,0"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           TextWrapping="Wrap"
                           Text="{DynamicResource userScriptManager_invalidMetadata}"
                           Visibility="Collapsed"/>

                <Border x:Name="metadataSection"
                        Margin="0,14,0,0"
                        Padding="0,6,0,0"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,1,0,0">
                    <ItemsControl x:Name="metadataRows" ItemTemplate="{StaticResource MetadataRowTemplate}"/>
                </Border>

                <Border x:Name="unknownMetadataSection"
                        Margin="0,14,0,0"
                        Padding="0,12,0,0"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,1,0,0"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Foreground="{DynamicResource PrimaryTextBrush}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Text="{DynamicResource userScriptDetails_unknownMetadata}"/>
                        <ItemsControl x:Name="unknownMetadataRows" ItemTemplate="{StaticResource MetadataRowTemplate}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
