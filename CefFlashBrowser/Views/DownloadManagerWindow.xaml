<Window x:Class="CefFlashBrowser.Views.DownloadManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource downloads_title}" Width="1040" Height="620" MinWidth="760" MinHeight="400"
        Background="{DynamicResource RegionBrush}" Foreground="{DynamicResource PrimaryTextBrush}">
    <DockPanel Margin="12" Background="{DynamicResource RegionBrush}">
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <Button Content="{DynamicResource downloads_new}" Command="{Binding NewCommand}" Margin="0,0,6,6"/>
            <Button Content="{DynamicResource downloads_pause}" Command="{Binding PauseCommand}" Margin="0,0,6,6"/>
            <Button Content="{DynamicResource downloads_resume}" Command="{Binding ResumeCommand}" Margin="0,0,6,6"/>
            <Button Content="{DynamicResource common_cancel}" Command="{Binding CancelCommand}" Margin="0,0,6,6"/>
            <Button Content="{DynamicResource downloads_open}" Command="{Binding OpenCommand}" Margin="0,0,6,6"/>
            <Button Content="{DynamicResource downloads_folder}" Command="{Binding FolderCommand}" Margin="0,0,6,6"/>
            <Button Content="{DynamicResource downloads_remove}" Command="{Binding RemoveCommand}" Margin="0,0,6,6"/>
            <Button Content="{DynamicResource downloads_deleteFile}" Command="{Binding DeleteFileCommand}" Margin="0,0,6,6"/>
            <Button Content="{DynamicResource downloads_clear}" Command="{Binding ClearCommand}" Margin="0,0,6,6"/>
        </WrapPanel>
        <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="{Binding SelectedItem.FilePath}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedItem.FilePath}"/>
            <TextBlock Grid.Row="1" Text="{Binding SelectedItem.Url}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedItem.Url}" Margin="0,4,0,0"/>
            <TextBlock Grid.Row="2" Text="{Binding SelectedItem.Error}" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </Grid>
        <ListView x:Name="downloadList" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                  SelectionMode="Single" MouseDoubleClick="OpenSelected" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
            <ListView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="{DynamicResource downloads_open}" Command="{Binding OpenCommand}"/>
                    <MenuItem Header="{DynamicResource downloads_folder}" Command="{Binding FolderCommand}"/>
                    <Separator/>
                    <MenuItem Header="{DynamicResource downloads_pause}" Command="{Binding PauseCommand}"/>
                    <MenuItem Header="{DynamicResource downloads_resume}" Command="{Binding ResumeCommand}"/>
                    <MenuItem Header="{DynamicResource common_cancel}" Command="{Binding CancelCommand}"/>
                    <Separator/>
                    <MenuItem Header="{DynamicResource downloads_remove}" Command="{Binding RemoveCommand}"/>
                    <MenuItem Header="{DynamicResource downloads_deleteFile}" Command="{Binding DeleteFileCommand}"/>
                </ContextMenu>
            </ListView.ContextMenu>
            <ListView.View>
                <GridView AllowsColumnReorder="True">
                    <GridViewColumn Header="{DynamicResource downloads_fileName}" Width="240">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate><TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FilePath}"/></DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="{DynamicResource downloads_progress}" Width="155">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ProgressBar Value="{Binding Progress, Mode=OneWay}" IsIndeterminate="{Binding IsIndeterminate}"
                                                 Style="{StaticResource ProgressBarFlat}" Width="95" Height="5" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding ProgressText}" Margin="8,0,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="{DynamicResource downloads_size}" Width="180" DisplayMemberBinding="{Binding Size}"/>
                    <GridViewColumn Header="{DynamicResource downloads_speed}" Width="110" DisplayMemberBinding="{Binding Speed}"/>
                    <GridViewColumn Header="{DynamicResource downloads_state}" Width="125" DisplayMemberBinding="{Binding State}"/>
                    <GridViewColumn Header="{DynamicResource downloads_source}" Width="95" DisplayMemberBinding="{Binding Source}"/>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
